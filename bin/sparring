#!/bin/bash

# Sparring — AI 左右脑互搏 (原 Dual AI Workflow)
# 支持动态角色分配：执行者(Executor) 和 观察者(Reviewer)

set -euo pipefail

# 颜色输出（用 $'...' 存真正的 ESC 字节，这样 heredoc / printf '%s' 都能正确渲染；
# echo -e 也仍然兼容——它看到的就是已解释好的字节）
GREEN=$'\033[0;32m'
BLUE=$'\033[0;34m'
YELLOW=$'\033[1;33m'
RED=$'\033[0;31m'
DIM=$'\033[2m'
NC=$'\033[0m'

# 配置
MAX_REVIEW_ROUNDS=5
# AGENT_TIMEOUT / AGENT_RETRIES 由 _config_get 惰性求值，见下方 Config 段
# 内部循环总尝试次数 = retries + 1（保底至少 1 次）
_agent_attempts() {
    local retries
    retries=$(_config_get review.retries)
    local n=$(( retries + 1 ))
    [[ $n -lt 1 ]] && n=1
    echo $n
}
# 兼容访问器（延迟求值，读当前 config）
# reviewer 是自己跑 git/读文件的 agent，耗时以分钟计且跟送审体量不成正比
# （审的是仓库不是一段文本），所以用扁平超时，不按内容大小加时。
_agent_timeout() { _config_get review.timeout; }
# Resolve symlink to find real script location
_resolve_script_dir() {
    local src="$0"
    while [[ -L "$src" ]]; do
        local dir
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")/.." && pwd
}
# GitHub Issue 配置
ISSUE_POLL_INTERVAL="${WORKFLOW_POLL_INTERVAL:-30}"
ISSUE_LABEL="${WORKFLOW_ISSUE_LABEL:-claude-ok}"
ISSUE_PROJECT_NUMBER="${WORKFLOW_PROJECT_NUMBER:-}"
ISSUE_PROJECT_OWNER="${WORKFLOW_PROJECT_OWNER:-}"
REVIEW_BACKEND_DEFAULT="claude"
REVIEW_BACKENDS="claude / opencode"

# ─── Reviewer Backend 配置 ───────────────────────────────────

_normalize_backend() {
    local backend="$1"
    backend=$(printf '%s' "$backend" | tr '[:upper:]' '[:lower:]')
    case "$backend" in
        claude|opencode) echo "$backend"; return 0 ;;
        *) return 1 ;;
    esac
}

# 审查强度。直接对齐 claude /code-review 的四档：低档少而准，高档广而杂。
# opencode 没有原生等价物，由注入的对抗 prompt 翻译成"挖多深"（见 _level_directive）。
REVIEW_LEVELS="low / medium / high / xhigh"
REVIEW_LEVEL_DEFAULT="medium"

_normalize_level() {
    local level="$1"
    level=$(printf '%s' "$level" | tr '[:upper:]' '[:lower:]')
    case "$level" in
        low|medium|high|xhigh) echo "$level"; return 0 ;;
        *) return 1 ;;
    esac
}

get_review_level() {
    local raw
    raw=$(_config_get review.level)
    [[ -z "$raw" ]] && raw="$REVIEW_LEVEL_DEFAULT"
    local level
    if ! level=$(_normalize_level "$raw"); then
        echo -e "${RED}错误: review.level 仅支持 ${REVIEW_LEVELS}${NC}" >&2
        echo "  收到: '${raw}'" >&2
        return 1
    fi
    echo "$level"
}

get_review_backend() {
    local raw
    raw=$(_config_get review.backend)
    [[ -z "$raw" ]] && raw="$REVIEW_BACKEND_DEFAULT"
    local backend
    if ! backend=$(_normalize_backend "$raw"); then
        echo -e "${RED}错误: review.backend 仅支持 ${REVIEW_BACKENDS}${NC}" >&2
        echo "  收到: '${raw}'" >&2
        return 1
    fi
    echo "$backend"
}

# 降级后端，空值表示未配置
get_review_backend_fallback() {
    local raw
    raw=$(_config_get review.fallback)
    [[ -z "$raw" ]] && return 0
    local backend
    if ! backend=$(_normalize_backend "$raw"); then
        echo -e "${RED}错误: review.fallback 仅支持 ${REVIEW_BACKENDS}${NC}" >&2
        echo "  收到: '${raw}'" >&2
        return 1
    fi
    echo "$backend"
}

# 存进 meta.json 的机器名
reviewer_name_for_backend() {
    echo "$1"
}

# 给人看的展示名
reviewer_label_for_backend() {
    local backend="$1"
    case "$backend" in
        claude)   echo "Claude Code" ;;
        opencode) echo "opencode (plan)" ;;
        *)        echo "$backend" ;;
    esac
}

# ─── Project 链接解析 ────────────────────────────────────────

# 从 GitHub Project URL 解析 owner 和 number
# 支持格式: https://github.com/orgs/<owner>/projects/<number>
#           https://github.com/users/<owner>/projects/<number>
parse_project_url() {
    local url="$1"
    if [[ "$url" =~ github\.com/(orgs|users)/([^/]+)/projects/([0-9]+) ]]; then
        ISSUE_PROJECT_OWNER="${BASH_REMATCH[2]}"
        ISSUE_PROJECT_NUMBER="${BASH_REMATCH[3]}"
        return 0
    fi
    return 1
}

# 设置 project 上下文（从 URL 或环境变量）
# Usage: set_project "https://github.com/orgs/xxx/projects/3"
#   or:  set_project  (使用环境变量)
set_project() {
    local url="${1:-}"
    if [[ -n "$url" ]]; then
        if parse_project_url "$url"; then
            echo -e "${DIM}  Project: ${ISSUE_PROJECT_OWNER} #${ISSUE_PROJECT_NUMBER}${NC}" >&2
        else
            echo -e "${RED}错误: 无法解析 project URL: ${url}${NC}" >&2
            echo "  支持格式: https://github.com/orgs/<owner>/projects/<number>" >&2
            return 1
        fi
    fi

    if [[ -z "$ISSUE_PROJECT_OWNER" || -z "$ISSUE_PROJECT_NUMBER" ]]; then
        echo -e "${YELLOW}⚠ 未指定 project，看板状态不会更新${NC}" >&2
        echo "  传入 project URL 或设置 WORKFLOW_PROJECT_OWNER + WORKFLOW_PROJECT_NUMBER" >&2
    fi
}

# ─── 依赖检查 ───────────────────────────────────────────────

check_deps() {
    local missing=()
    command -v jq &>/dev/null || missing+=("jq")
    if [[ ${#missing[@]} -gt 0 ]]; then
        echo -e "${RED}错误: 缺少依赖: ${missing[*]}${NC}"
        echo "  brew install ${missing[*]}"
        exit 1
    fi
}

check_claude() {
    if ! command -v claude &>/dev/null; then
        echo -e "${RED}错误: 未找到 claude 命令 (Claude Code CLI)${NC}" >&2
        echo "  请安装: npm install -g @anthropic-ai/claude-code" >&2
        return 1
    fi
}

check_opencode() {
    if ! command -v opencode &>/dev/null; then
        echo -e "${RED}错误: 未找到 opencode 命令${NC}" >&2
        echo "  请安装: https://opencode.ai/docs" >&2
        return 1
    fi
}

# 后端可用性检查（每个后端一个 check_<backend>）
check_backend() {
    case "$1" in
        claude)   check_claude ;;
        opencode) check_opencode ;;
        *)        echo -e "${RED}错误: 不支持的 reviewer backend: $1${NC}" >&2; return 1 ;;
    esac
}

# ─── 项目根目录查找（向上查找 .workflow 或 .git） ──────────

find_project_root() {
    local dir="$PWD"
    # Walk up preferring .workflow (sparring project root) over bare git root.
    # Check [[ -e .git ]] instead of [[ -d .git ]] so git worktrees are detected:
    # in a worktree .git is a file (gitdir pointer), not a directory.
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.workflow" ]]; then
            echo "$dir"
            return 0
        fi
        if [[ -e "$dir/.git" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    echo "$PWD"
}

PROJECT_ROOT="$(find_project_root)"
WORKFLOW_DIR="${PROJECT_ROOT}/.workflow"

# ─── 配置层（default < global < project < env） ──────────
# global: ~/.config/sparring/config.json
# project: <PROJECT_ROOT>/.sparring/config.json
# env: SPARRING_* 或 WORKFLOW_*（兼容别名）

# 所有路径都允许通过同名环境变量覆盖（测试 / CI 隔离）
CONFIG_DIR_GLOBAL="${CONFIG_DIR_GLOBAL:-${XDG_CONFIG_HOME:-$HOME/.config}/sparring}"
CONFIG_FILE_GLOBAL="${CONFIG_FILE_GLOBAL:-${CONFIG_DIR_GLOBAL}/config.json}"
CONFIG_DIR_PROJECT="${CONFIG_DIR_PROJECT:-${PROJECT_ROOT}/.sparring}"
CONFIG_FILE_PROJECT="${CONFIG_FILE_PROJECT:-${CONFIG_DIR_PROJECT}/config.json}"

# 内置默认 — 所有可配置字段都要在这里给出非 null 默认或显式 null
_config_defaults() {
    cat <<'EOF'
{
  "review": {
    "backend": "claude",
    "fallback": "opencode",
    "level": "medium",
    "timeout": 1800,
    "retries": 1,
    "log_retention_days": 7
  },
  "claude": {
    "model": null,
    "use_proxy": false,
    "extra_args": null
  },
  "opencode": {
    "model": null,
    "base_url": null,
    "api_key": null,
    "use_proxy": false,
    "extra_args": null
  }
}
EOF
}

# 读 JSON 文件，不存在或格式错返回 {}
# 格式错每文件只告警一次（哨兵文件写到 /tmp，避免 $(...) subshell 里 export 丢失）
# 哨兵文件以 PID + 文件路径的 hash 命名，脚本退出时由 trap 清理
_config_warn_sentinel() {
    local file="$1"
    local safe
    safe=$(printf '%s' "$file" | tr -c 'A-Za-z0-9' '_')
    echo "${TMPDIR:-/tmp}/workflow-cfg-warn-$$-${safe}"
}

_config_read_file() {
    local file="$1"
    [[ ! -f "$file" ]] && { echo '{}'; return 0; }
    if ! jq -e '.' "$file" >/dev/null 2>&1; then
        local sentinel
        sentinel=$(_config_warn_sentinel "$file")
        if [[ ! -f "$sentinel" ]]; then
            echo -e "${YELLOW}⚠ 配置文件格式错误，忽略: ${file}${NC}" >&2
            echo -e "${DIM}  (本次运行仅提示一次；用 jq . 该文件自查)${NC}" >&2
            touch "$sentinel" 2>/dev/null || true
        fi
        echo '{}'
        return 0
    fi
    cat "$file"
}

# 哨兵文件留在 /tmp 里，PID 防冲突；进程结束后文件无人用。
# 不 trap EXIT 清理，避免在 $(...) 子 shell 退出时误删正在用的哨兵。

# 合并 default + global + project，后者覆盖前者（递归合并）
_config_merged() {
    local defaults global project
    defaults=$(_config_defaults)
    global=$(_config_read_file "$CONFIG_FILE_GLOBAL")
    project=$(_config_read_file "$CONFIG_FILE_PROJECT")
    # jq 的 * 是递归合并
    jq -n --argjson a "$defaults" --argjson b "$global" --argjson c "$project" '$a * $b * $c'
}

# key.path 转环境变量名（点号转下划线、全大写）
_env_name_for_path() {
    printf '%s' "$1" | tr '[:lower:].' '[:upper:]_'
}

# 读单个配置值
# _config_get <key.path>
# 优先级：SPARRING_<KEY> > WORKFLOW_<KEY>（兼容） > project > global > default
# Usage: _config_get review.backend
#        _config_get claude.model
_config_get() {
    local path="$1"
    [[ -z "$path" ]] && { echo ""; return 0; }

    local env_suffix
    env_suffix=$(_env_name_for_path "$path")
    local sparring_var="SPARRING_${env_suffix}"
    local workflow_var="WORKFLOW_${env_suffix}"

    # SPARRING_* 最高优先级
    if [[ -n "${!sparring_var:-}" ]]; then
        printf '%s' "${!sparring_var}"
        return 0
    fi
    # WORKFLOW_* 兼容别名（schema 对齐的名字）
    if [[ -n "${!workflow_var:-}" ]]; then
        printf '%s' "${!workflow_var}"
        return 0
    fi
    # WORKFLOW_* 历史命名的兼容别名（e.g. WORKFLOW_REVIEW_BACKEND_FALLBACK → review.fallback）
    local legacy
    if legacy=$(_workflow_legacy_alias "$path"); then
        printf '%s' "$legacy"
        return 0
    fi

    # 从合并后的 JSON 取值
    local jq_filter=".${path}"
    local val
    val=$(_config_merged | jq -r "${jq_filter} // \"\"" 2>/dev/null)
    # jq 把 null 渲染成 "null" 字符串时（用 // 后不会，但兜底），统一视为空
    [[ "$val" == "null" ]] && val=""
    printf '%s' "$val"
}

# WORKFLOW_* 历史变量到新字段的别名映射（只处理两个不符合 naming convention 的）
# SPARRING_* 前缀是新引入的，直接跟 schema 对齐（如 SPARRING_REVIEW_FALLBACK），不需要 legacy map
_workflow_legacy_alias() {
    local path="$1"
    case "$path" in
        review.fallback)
            [[ -n "${WORKFLOW_REVIEW_BACKEND_FALLBACK:-}" ]] && { printf '%s' "$WORKFLOW_REVIEW_BACKEND_FALLBACK"; return 0; }
            ;;
    esac
    return 1
}
PLANS_DIR="${WORKFLOW_DIR}/plans"
REVIEW_JOBS_DIR="${WORKFLOW_DIR}/review-jobs"

# ─── Review 约定 (.sparring/REVIEW.md) ──────────────────────
# 查找顺序：项目级 → 全局 → 空字符串
# 内联进 reviewer prompt（reviewer 的 cwd 里也能读到项目级那份，但全局那份只有这条路径能给它）
load_review_conventions() {
    local project_file="${CONFIG_DIR_PROJECT}/REVIEW.md"
    local global_file="${CONFIG_DIR_GLOBAL}/REVIEW.md"
    if [[ -f "$project_file" ]]; then
        cat "$project_file"
    elif [[ -f "$global_file" ]]; then
        cat "$global_file"
    fi
}

# ─── 输入验证 ───────────────────────────────────────────────

validate_task_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9_-]+$ ]]; then
        echo -e "${RED}错误: 任务名只能包含字母、数字、下划线、横杠${NC}"
        echo "  收到: '$name'"
        exit 1
    fi
}

validate_executor() {
    local executor="$1"
    if [[ "$executor" != "claude" && "$executor" != "cursor" ]]; then
        echo -e "${RED}错误: executor 必须是 claude 或 cursor${NC}"
        echo "  收到: '$executor'"
        exit 1
    fi
}

validate_task_id() {
    local task_id="$1"
    if [[ ! "$task_id" =~ ^[0-9]{8}-[0-9]{6}-[a-zA-Z0-9_-]+$ ]]; then
        echo -e "${RED}错误: task-id 格式非法${NC}"
        echo "  期望格式: YYYYMMDD-HHMMSS-task-name"
        echo "  收到: '$task_id'"
        exit 1
    fi
}

validate_task_exists() {
    local task_id="$1"
    if [[ -z "$task_id" ]]; then
        echo -e "${RED}错误: 请提供 task-id${NC}"
        exit 1
    fi
    validate_task_id "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    if [[ ! -d "$task_dir" || ! -f "$task_dir/meta.json" ]]; then
        echo -e "${RED}错误: 任务不存在: ${task_id}${NC}"
        exit 1
    fi
}

# ─── 安全的 JSON 更新 ───────────────────────────────────────

update_meta() {
    local task_dir="$1"
    shift
    # 最后一个参数是 jq 表达式，前面的都是 jq 选项（如 --arg）
    local args=("$@")
    local last_idx=$(( ${#args[@]} - 1 ))
    local jq_expr="${args[$last_idx]}"
    local -a jq_opts=()
    if [[ $last_idx -gt 0 ]]; then
        jq_opts=("${args[@]:0:$last_idx}")
    fi
    local tmp="${task_dir}/meta.json.tmp"

    local jq_status=0
    if [[ ${#jq_opts[@]} -gt 0 ]]; then
        jq "${jq_opts[@]}" "$jq_expr" "${task_dir}/meta.json" > "$tmp" || jq_status=$?
    else
        jq "$jq_expr" "${task_dir}/meta.json" > "$tmp" || jq_status=$?
    fi

    if [[ $jq_status -ne 0 ]]; then
        rm -f "$tmp"
        echo -e "${RED}错误: JSON 更新失败${NC}"
        return 1
    fi
    mv -f "$tmp" "${task_dir}/meta.json"
}

# ─── 后台 Review 作业管理 ─────────────────────────────────────

ensure_review_jobs_dir() {
    mkdir -p "${REVIEW_JOBS_DIR}"
}

generate_review_job_id() {
    printf 'rj-%s-%04x' "$(date +%Y%m%d%H%M%S)" "$((RANDOM % 65536))"
}

review_job_file_path() {
    local job_id="$1"
    echo "${REVIEW_JOBS_DIR}/${job_id}.json"
}

review_job_log_path() {
    local job_id="$1"
    echo "${REVIEW_JOBS_DIR}/${job_id}.log"
}

review_job_result_path() {
    local job_id="$1"
    echo "${REVIEW_JOBS_DIR}/${job_id}.result.md"
}

review_job_update() {
    local job_file="$1"
    shift

    if [[ ! -f "$job_file" ]]; then
        echo -e "${RED}错误: review job 不存在: ${job_file}${NC}" >&2
        return 1
    fi

    local args=("$@")
    local last_idx=$(( ${#args[@]} - 1 ))
    local jq_expr="${args[$last_idx]}"
    local -a jq_opts=()
    if [[ $last_idx -gt 0 ]]; then
        jq_opts=("${args[@]:0:$last_idx}")
    fi

    local tmp="${job_file}.tmp"
    local jq_status=0
    if [[ ${#jq_opts[@]} -gt 0 ]]; then
        jq "${jq_opts[@]}" "$jq_expr" "$job_file" > "$tmp" || jq_status=$?
    else
        jq "$jq_expr" "$job_file" > "$tmp" || jq_status=$?
    fi

    if [[ $jq_status -ne 0 ]]; then
        rm -f "$tmp"
        echo -e "${RED}错误: review job JSON 更新失败${NC}" >&2
        return 1
    fi
    mv -f "$tmp" "$job_file"
}

start_background_review() {
    local review_type="$1"
    local task_id="$2"

    validate_task_exists "$task_id"
    [[ "$review_type" != "proposal" && "$review_type" != "code" ]] && {
        echo -e "${RED}错误: review_type 必须是 proposal 或 code${NC}"
        return 1
    }

    ensure_review_jobs_dir
    local backend
    backend=$(get_review_backend) || return 1

    local job_id
    job_id=$(generate_review_job_id)
    local job_file
    job_file=$(review_job_file_path "$job_id")
    local log_file
    log_file=$(review_job_log_path "$job_id")
    local result_file
    result_file=$(review_job_result_path "$job_id")

    jq -n \
        --arg job_id "$job_id" \
        --arg task_id "$task_id" \
        --arg review_type "$review_type" \
        --arg backend "$backend" \
        --arg ts "$(date -Iseconds)" \
        --arg log_file "$log_file" \
        --arg result_file "$result_file" \
        '{
            job_id: $job_id,
            task_id: $task_id,
            review_type: $review_type,
            backend: $backend,
            status: "queued",
            created_at: $ts,
            started_at: null,
            completed_at: null,
            pid: null,
            exit_code: null,
            error_reason: null,
            review_state: null,
            review_file: null,
            result_file: $result_file,
            log_file: $log_file
        }' > "$job_file"

    : > "$log_file"

    local script_path
    script_path="$(_resolve_script_dir)/bin/sparring"
    nohup bash "$script_path" __review-worker "$review_type" "$task_id" "$job_id" >> "$log_file" 2>&1 &
    local pid=$!

    review_job_update "$job_file" \
        --argjson pid "$pid" \
        '.pid = $pid'

    echo -e "${GREEN}✓ 后台 review 已启动: ${job_id}${NC}"
    echo -e "${BLUE}  类型: ${review_type}  任务: ${task_id}  backend: ${backend}${NC}"
    echo "  状态查看: sparring review-status ${job_id}"
    echo "  查看结果: sparring review-result ${job_id}"
    echo "  取消任务: sparring review-cancel ${job_id}"
}

run_review_worker() {
    local review_type="$1"
    local task_id="$2"
    local job_id="$3"

    validate_task_exists "$task_id"

    local job_file
    job_file=$(review_job_file_path "$job_id")
    local log_file
    log_file=$(review_job_log_path "$job_id")
    local result_file
    result_file=$(review_job_result_path "$job_id")

    local ts
    ts="$(date -Iseconds)"
    review_job_update "$job_file" \
        --arg ts "$ts" \
        --argjson pid "$$" \
        '.status = "running" | .started_at = $ts | .pid = $pid'

    local task_dir="${PLANS_DIR}/${task_id}"
    local review_pattern review_step
    if [[ "$review_type" == "proposal" ]]; then
        review_pattern="proposal-review-*.md"
        review_step="proposal_review"
    else
        review_pattern="code-review-*.md"
        review_step="code_review"
    fi

    local before_count after_count
    before_count=$(find "${task_dir}" -name "$review_pattern" 2>/dev/null | wc -l | tr -d ' ')

    local rc
    set +e
    if [[ "$review_type" == "proposal" ]]; then
        review_proposal "$task_id"
    else
        review_code "$task_id"
    fi
    rc=$?
    set -e

    after_count=$(find "${task_dir}" -name "$review_pattern" 2>/dev/null | wc -l | tr -d ' ')
    local latest_review_file=""
    if [[ "$after_count" -gt "$before_count" ]]; then
        latest_review_file=$(find "${task_dir}" -name "$review_pattern" -print | sort | tail -1)
    else
        latest_review_file=$(find "${task_dir}" -name "$review_pattern" -print | sort | tail -1)
    fi

    if [[ -n "$latest_review_file" && -f "$latest_review_file" ]]; then
        cp "$latest_review_file" "$result_file"
    fi

    local review_state
    review_state=$(jq -r --arg step "$review_step" '.steps[$step] // empty' "${task_dir}/meta.json")
    local status="completed"
    [[ $rc -ne 0 ]] && status="failed"

    ts="$(date -Iseconds)"
    review_job_update "$job_file" \
        --arg status "$status" \
        --arg ts "$ts" \
        --argjson rc "$rc" \
        --arg review_state "$review_state" \
        --arg review_file "$latest_review_file" \
        --arg result_file "$result_file" \
        '.status = $status
         | .completed_at = $ts
         | .final_pid = .pid
         | .pid = null
         | .exit_code = $rc
         | .review_state = $review_state
         | .review_file = (if $review_file == "" then null else $review_file end)
         | .result_file = $result_file'

    if [[ "$status" == "completed" ]]; then
        echo -e "${GREEN}✓ 后台 review 完成: ${job_id}${NC}" >> "$log_file"
    else
        echo -e "${RED}✗ 后台 review 失败: ${job_id}${NC}" >> "$log_file"
    fi

    return 0
}

# 背景 worker 被 kill / OOM / 机器重启后，job JSON 会永远停在 running——
# 状态查询是唯一会再看它的地方，就在这里就地改判，不让"静默挂死"以 running 的样子留着。
# 判定要三个条件同时成立：状态还在跑 + 记了 pid + 这个 pid 已经没了。
# （正常完成时 pid 被置 null、值搬去 final_pid，只看 kill -0 会把完成的误判成 failed。）
_review_job_reap() {
    local job_file="$1"
    local status pid
    status=$(jq -r '.status // empty' "$job_file" 2>/dev/null) || return 0
    [[ "$status" == "queued" || "$status" == "running" ]] || return 0
    pid=$(jq -r '.pid // empty' "$job_file" 2>/dev/null) || return 0
    [[ -n "$pid" ]] || return 0
    kill -0 "$pid" 2>/dev/null && return 0

    local ts
    ts="$(date -Iseconds)"
    review_job_update "$job_file" \
        --arg ts "$ts" \
        '.status = "failed"
         | .completed_at = $ts
         | .final_pid = .pid
         | .pid = null
         | .exit_code = (.exit_code // 1)
         | .error_reason = "crash"' >/dev/null 2>&1 || return 0
    echo -e "${YELLOW}⚠ job $(jq -r '.job_id' "$job_file") 的 worker (pid ${pid}) 已不在，改判 failed${NC}" >&2
}

show_review_status() {
    ensure_review_jobs_dir
    local ref="${1:-}"

    if [[ -n "$ref" && -f "$(review_job_file_path "$ref")" ]]; then
        local job_file
        job_file=$(review_job_file_path "$ref")
        _review_job_reap "$job_file"
        echo -e "${BLUE}=== Review Job: ${ref} ===${NC}"
        jq '.' "$job_file"
        local log_file
        log_file=$(jq -r '.log_file // empty' "$job_file")
        if [[ -n "$log_file" && -f "$log_file" ]]; then
            echo ""
            echo -e "${BLUE}最近日志:${NC}"
            tail -n 20 "$log_file"
        fi
        return 0
    fi

    local files=("${REVIEW_JOBS_DIR}"/*.json)
    if [[ ${#files[@]} -eq 0 || ! -e "${files[0]}" ]]; then
        echo "暂无后台 review 作业"
        return 0
    fi

    echo -e "${BLUE}=== Review Jobs ===${NC}"
    printf "%-24s %-10s %-9s %-8s %-28s\n" "JOB_ID" "STATUS" "TYPE" "BACKEND" "TASK_ID"
    for job_file in "${files[@]}"; do
        local job_id status review_type backend task_id
        _review_job_reap "$job_file"
        job_id=$(jq -r '.job_id' "$job_file")
        status=$(jq -r '.status' "$job_file")
        review_type=$(jq -r '.review_type' "$job_file")
        backend=$(jq -r '.backend' "$job_file")
        task_id=$(jq -r '.task_id' "$job_file")

        if [[ -n "$ref" && "$task_id" != "$ref" ]]; then
            continue
        fi
        printf "%-24s %-10s %-9s %-8s %-28s\n" "$job_id" "$status" "$review_type" "$backend" "$task_id"
    done
}

show_review_result() {
    local job_id="${1:-}"
    if [[ -z "$job_id" ]]; then
        echo -e "${RED}错误: 请提供 job-id${NC}"
        echo "用法: sparring review-result <job-id>"
        return 1
    fi

    local job_file
    job_file=$(review_job_file_path "$job_id")
    if [[ ! -f "$job_file" ]]; then
        echo -e "${RED}错误: review job 不存在: ${job_id}${NC}"
        return 1
    fi

    local status result_file review_file
    status=$(jq -r '.status' "$job_file")
    result_file=$(jq -r '.result_file // empty' "$job_file")
    review_file=$(jq -r '.review_file // empty' "$job_file")

    if [[ "$status" == "queued" || "$status" == "running" ]]; then
        echo -e "${YELLOW}作业尚未完成: ${job_id} (${status})${NC}"
        echo "查看状态: sparring review-status ${job_id}"
        return 0
    fi

    if [[ -n "$result_file" && -f "$result_file" ]]; then
        cat "$result_file"
        return 0
    fi

    if [[ -n "$review_file" && -f "$review_file" ]]; then
        cat "$review_file"
        return 0
    fi

    echo -e "${YELLOW}未找到 review 结果文件${NC}"
    echo "查看详情: sparring review-status ${job_id}"
}

cancel_review_job() {
    local job_id="${1:-}"
    if [[ -z "$job_id" ]]; then
        echo -e "${RED}错误: 请提供 job-id${NC}"
        echo "用法: sparring review-cancel <job-id>"
        return 1
    fi

    local job_file
    job_file=$(review_job_file_path "$job_id")
    if [[ ! -f "$job_file" ]]; then
        echo -e "${RED}错误: review job 不存在: ${job_id}${NC}"
        return 1
    fi

    local status pid
    status=$(jq -r '.status' "$job_file")
    pid=$(jq -r '.pid // empty' "$job_file")

    if [[ "$status" != "queued" && "$status" != "running" ]]; then
        echo -e "${YELLOW}作业不是运行态，无需取消: ${job_id} (${status})${NC}"
        return 0
    fi

    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
    fi

    local ts
    ts="$(date -Iseconds)"
    review_job_update "$job_file" \
        --arg ts "$ts" \
        '.status = "cancelled" | .completed_at = $ts | .final_pid = .pid | .pid = null'

    echo -e "${GREEN}✓ 已取消 review job: ${job_id}${NC}"
}

# ─── Issue 同步 ──────────────────────────────────────────────

# 如果任务关联了 issue，同步 comment（带身份标记）
# Usage: sync_to_issue <task_dir> <agent_name> <phase_label> <body>
# Example: sync_to_issue "$task_dir" "Claude Code" "Proposal Review" "$review_result"
sync_to_issue() {
    local task_dir="$1"
    local agent_name="$2"
    local phase_label="$3"
    local body="$4"

    local issue_number repo
    issue_number=$(jq -r '.issue_number // empty' "${task_dir}/meta.json")
    repo=$(jq -r '.repo // empty' "${task_dir}/meta.json")

    [[ -z "$issue_number" || -z "$repo" ]] && return 0

    local icon
    case "$agent_name" in
        *Claude*|*claude*)     icon="🧠" ;;
        *opencode*|*Opencode*) icon="🛠" ;;
        *)                     icon="🔧" ;;
    esac

    local comment="${icon} **[${agent_name} — ${phase_label}]**

${body}"

    gh issue comment "$issue_number" --repo "$repo" --body "$comment" >/dev/null 2>&1 || {
        echo -e "${DIM}  (Issue 同步失败，继续本地流程)${NC}" >&2
    }
}

# ─── Agent 调用封装 ──────────────────────────────────────────

_timeout_cmd() {
    local duration="$1"
    shift
    # 超时要杀掉整棵进程树，不是只杀直接子进程：两个后端都会派生孙进程
    # （opencode 起本地 server，claude 跑 Bash 工具），只 kill 直接子进程会留下
    # 孤儿继续跑满额度。GNU timeout 默认就把子进程放进新进程组、超时对整组发信号
    # （coreutils 9.11 实测孙进程一并清掉），所以它这条路天然是对的；
    # perl 兜底路径得自己 setpgrp 建组 + 对负 pid 发信号。
    # -k 10: TERM 后 10s 仍活着补 SIGKILL（跑飞的 curl 可能不理 TERM，
    # 实测出现过超时设置形同虚设、请求挂满 20min 的情况）
    if command -v timeout &>/dev/null; then
        timeout -k 10 "$duration" "$@"
    elif command -v gtimeout &>/dev/null; then
        gtimeout -k 10 "$duration" "$@"
    else
        # macOS fallback: perl（本机没装 coreutils 时走这条）。与 GNU timeout 对齐：
        # 超时先 TERM 整组，10s 内没退干净补 KILL；超时退出码 124；子进程死于信号时
        # 返回 128+sig（旧实现 $? >> 8 会把 SIGKILL 死亡误报成 exit 0）
        perl -e '
            use POSIX ":sys_wait_h";
            my $timeout = shift @ARGV;
            my $pid = fork();
            # 子进程自立门户当进程组组长（pgid == pid），这样 kill -$pid 覆盖它的孙进程。
            # macOS 不自带 setsid(1)，所以只能在这里做。
            if ($pid == 0) { setpgrp(0, 0); exec @ARGV; exit 127; }
            my $timed_out = 0;
            local $SIG{ALRM} = sub {
                $timed_out = 1;
                kill "TERM", -$pid;
                my $waited = 0;
                while ($waited < 10 && waitpid($pid, WNOHANG) == 0) {
                    select(undef, undef, undef, 0.1);
                    $waited += 0.1;
                }
                # 无条件对整组补 KILL：子进程可能已退出、但它派生的孙进程还活着，
                # 按 waitpid 结果决定就会把这种孤儿漏掉
                kill "KILL", -$pid;
            };
            alarm $timeout;
            waitpid($pid, 0);
            alarm 0;
            exit 124 if $timed_out;
            my $st = $?;
            exit(($st & 127) ? 128 + ($st & 127) : ($st >> 8));
        ' "$duration" "$@"
    fi
}

# ─── 心跳 ────────────────────────────────────────────────────
# reviewer 一跑就是几分钟且全程没有输出，肉眼分不清"在想"和"挂了"。
# 每 15s 往 stderr 打一行活体信号——stderr 不进 $(...) 捕获，不会污染裁决文本。
_HEARTBEAT_PID=""

_heartbeat_start() {
    local label="$1"
    _heartbeat_stop
    (
        local elapsed=0
        while :; do
            sleep 15
            elapsed=$(( elapsed + 15 ))
            printf '%s\n' "${DIM}[sparring] ${label} 审查中… 已 ${elapsed}s${NC}" >&2
        done
    ) &
    _HEARTBEAT_PID=$!
}

# 幂等。wait 收尸避免 bash 打印 "Terminated" 作业消息。
_heartbeat_stop() {
    [[ -n "$_HEARTBEAT_PID" ]] || return 0
    local pid="$_HEARTBEAT_PID"
    _HEARTBEAT_PID=""
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
}

# ─── 失败原因 ────────────────────────────────────────────────
# 任何一次 review 只允许三种结局：APPROVE / CONCERNS / 带原因的显式 ERROR。
# reason ∈ timeout | crash | empty | parse。_call_backend 跑在 $(...) 子 shell 里，
# 变量传不回父进程，所以跟 backend 状态一样用文件回传（未设置文件时是 no-op）。
_error_reason_record() {
    [[ -n "${SPARRING_ERROR_REASON_FILE:-}" ]] || return 0
    printf '%s\n' "$1" > "$SPARRING_ERROR_REASON_FILE" 2>/dev/null || true
}

# ─── Reviewer 角色 prompt ────────────────────────────────────
# 两个后端共用。裁决格式是硬契约（上层按首列 APPROVE/CONCERNS 定退出码），
# 改这段等于改 sparring 的对外行为。
_reviewer_role_prompt() {
    cat <<'ROLEEOF'
你是严格的 code reviewer，工作在一个双 AI 协作流程里：搭档负责写，你负责挑毛病。

原则:
- 先理解再评判：看懂改动在整个项目里的位置和影响，再开口。
- 不讨好不客套：没问题就一句 APPROVE，别写"整体不错，但是"。
- 只提当前改动的真实问题：不提远期优化，不为假设性场景加防御，不凭空建议加抽象层。
- 关注正确性、边界情况、并发与资源泄漏、安全、错误处理、测试是否覆盖真实失败路径。
- 没把握时宁可提 CONCERNS，但每条都要说清"为什么这是本次改动的真实问题"。

响应格式必须严格二选一（首行就是裁决词，前面不加任何字符）：
1) 通过时：
APPROVE

[1-2 句理由，说清你验证了什么]

2) 有问题时：
CONCERNS

1. [问题 + 影响 + 修复建议]
2. ...

始终用中文，且不要输出其他格式。
ROLEEOF
}

# ─── 审查上下文 ─────────────────────────────────────────────
# 两条腿在 range 模式下差别很大（claude 用原生 /code-review，opencode 用注入的方法论），
# 命令组装得知道自己在审什么。bash 3.2 没法传结构体，用全局；调用方（_review_range /
# review_adhoc）负责设置，_review_run 负责透传给日志。
_RV_MODE="text"
_RV_RANGE=""
_RV_RIGHT=""
_RV_LEVEL="$REVIEW_LEVEL_DEFAULT"

# level 翻译成 opencode 能懂的"挖多深"。claude 腿不用这个——它直接吃 level 字面量。
_level_directive() {
    case "$1" in
        low)   echo "只报你有把握的高置信度问题；宁可少报，不要为凑数写猜测。" ;;
        medium) echo "覆盖四个角度，报确有依据的问题；不确定的可以报，但要写明不确定在哪。" ;;
        high)  echo "尽量广地覆盖，允许报把握不足的问题，但每条都要标注置信度。" ;;
        xhigh) echo "穷尽式排查：四个角度逐一走完，边界与异常路径全部推演一遍，宁可多报。" ;;
    esac
}

# ─── 后端命令组装 ───────────────────────────────────────────
# 每个后端只管"命令长什么样、喂什么输入"；超时、心跳、重试、输出清洗、裁决解析
# 都在 _call_backend 里共用。结果写进全局 AGENT_CMD（数组，bash 3.2 没法从函数返回）
# 和 AGENT_STDIN（喂给 CLI 的 stdin 文本，空串表示不喂）。
AGENT_STDIN=""

_agent_cmd_claude() {
    local model="$1"
    AGENT_CMD=(claude -p)
    if [[ "$_RV_MODE" == "range" ]]; then
        # 走 Claude Code 原生 /code-review：审查方法论在引擎里，我们只负责给
        # level + range + 附加指令。level 之后的文本会被当成附加审查指令传下去。
        local slash="/code-review ${_RV_LEVEL} ${_RV_RANGE}"
        [[ -n "$2" ]] && slash="${slash} ${2}"
        AGENT_CMD+=("$slash")
        AGENT_STDIN=""
    else
        # 纯文本审查（结论/方案）不适用 /code-review——它审的是代码改动。
        AGENT_STDIN="$2"
    fi
    AGENT_CMD+=(--output-format text)
    [[ -n "$model" ]] && AGENT_CMD+=(--model "$model")
    # Bash 必须显式预批：-p 是非交互的，没预批的工具会被直接拒（不是挂起等人点同意），
    # reviewer 跑不了 git diff 就只能盲审。实测这套只读白名单足够跑通 /code-review，
    # 不需要 --dangerously-skip-permissions。
    AGENT_CMD+=(--allowedTools "Bash Read Grep Glob")
    # 写类和联网工具一律禁掉。注意这只挡工具本身：Bash 仍能写文件，
    # 快照的"只读"靠的是审完就删，不是文件系统权限。
    AGENT_CMD+=(--disallowedTools "Edit Write NotebookEdit Task WebFetch WebSearch")
}

_agent_cmd_opencode() {
    local model="$1"
    # plan agent 默认就不带编辑能力，所以绝不能加 --auto。用户 shell 里 opencode 是个带
    # --auto 的 alias —— 脚本非交互执行不吃 alias，下面又统一经 env 直接 exec 二进制，天然绕开。
    # --agent plan 还有一个必要作用：压过用户全局配置里的 default_agent。
    AGENT_CMD=(opencode run --agent plan)
    [[ -n "$model" ]] && AGENT_CMD+=(-m "$model")
    AGENT_STDIN="$2"
}

# ─── opencode 认证注入 ───────────────────────────────────────
# base_url + api_key + model 三者齐全时，生成一份临时 opencode 配置，把网关声明成
# provider，用 OPENCODE_CONFIG 指给这次调用，用完删除。
# 实测 v1.18.16：OPENCODE_CONFIG 是「在用户全局配置之上合并」而非替换（用户自己的
# provider 仍然在列），所以这里只写 provider 块就够，用户的 ~/.config/opencode/opencode.json
# 全程不被读写。三者缺一就整体不生效（回落到用户自己的 opencode 配置），
# 不做"配一半"的中间状态。
_OPENCODE_GW_PROVIDER="sparring-gw"
_OPENCODE_GW_CONFIG=""

# 密钥支持 $ENV_VAR 形式引用环境变量，这样配置文件里可以不落明文
_resolve_secret() {
    local raw="$1"
    if [[ "$raw" == \$* ]]; then
        local var="${raw#\$}"
        printf '%s' "${!var:-}"
    else
        printf '%s' "$raw"
    fi
}

# 结果经两个全局变量回传：_OPENCODE_GW_MODEL（要用的 model）+ _OPENCODE_GW_CONFIG
# （临时配置路径，未配置网关时为空）。必须直呼、不能包在 $(...) 里——
# 命令替换的子 shell 会吞掉全局赋值（此前正是这个 bug 让网关配置从未生效）。
_OPENCODE_GW_MODEL=""
_opencode_gateway_setup() {
    _OPENCODE_GW_CONFIG=""
    local base_url api_key model
    base_url=$(_config_get opencode.base_url)
    api_key=$(_resolve_secret "$(_config_get opencode.api_key)")
    model=$(_config_get opencode.model)
    _OPENCODE_GW_MODEL="$model"

    if [[ -z "$base_url" || -z "$api_key" || -z "$model" ]]; then
        return 0
    fi

    local f
    if ! f=$(mktemp "${TMPDIR:-/tmp}/sparring-opencode-cfg.XXXXXX" 2>/dev/null); then
        return 0
    fi
    # 密钥落盘期间只对自己可读
    chmod 600 "$f" 2>/dev/null || true
    if ! jq -n \
            --arg p "$_OPENCODE_GW_PROVIDER" \
            --arg url "$base_url" \
            --arg key "$api_key" \
            --arg m "$model" \
            '{provider: {($p): {npm: "@ai-sdk/openai-compatible", name: "Sparring Gateway",
              options: {baseURL: $url, apiKey: $key}, models: {($m): {name: $m}}}}}' \
            > "$f" 2>/dev/null; then
        rm -f "$f" 2>/dev/null || true
        return 0
    fi
    _OPENCODE_GW_CONFIG="$f"
    _OPENCODE_GW_MODEL="${_OPENCODE_GW_PROVIDER}/${model}"
}

# 剥掉 agent CLI 的终端噪音：ANSI 序列 + "> plan · model" 这类进度头行。
# 实测重定向时 opencode 把它们写 stderr、stdout 干净，但接 TTY 时会混进来；
# 裁决是首列严格匹配，混进一个 ESC 序列就解析不出来。
_strip_agent_noise() {
    local esc=$'\033'
    sed -e "s/${esc}\[[0-9;?]*[A-Za-z]//g" -e "s/${esc}//g" -e '/^> .* · /d' -e '/./,$!d'
}

# opencode 腿的审查方法论。claude 腿不读它（用原生 /code-review）。
# 文件缺失是安装坏了：宁可硬报错，也不要静默降级成一次没有方法论的弱审查。
_adversarial_prompt() {
    local file
    file="$(_resolve_script_dir)/prompts/adversarial-review.md"
    if [[ ! -f "$file" ]]; then
        echo -e "${RED}错误: 找不到对抗式 review 方法论: ${file}${NC}" >&2
        echo "  这份文件是 opencode 后端的审查方法论，缺了它审查质量无从保证。" >&2
        return 1
    fi
    cat "$file"
}

# claude /code-review 的输出翻译成统一裁决契约。
# 它的原生格式跟 APPROVE/CONCERNS 不是一回事：无问题时输出字面量 "(none)"，
# 有问题时每行一条 "file:line — 描述"，两种情况都 exit 0。
# 翻译成统一契约后，上层 _review_run 的裁决解析对两条腿是同一套。
# 认不出来的一律返回失败（reason=parse），绝不默认放行。
_normalize_code_review_output() {
    local out="$1" level="$2"
    local trimmed
    trimmed=$(printf '%s' "$out" | tr -d '[:space:]')
    if [[ "$trimmed" == "(none)" ]]; then
        printf 'APPROVE\n\nclaude /code-review %s 走完未发现问题。\n' "$level"
        return 0
    fi
    # 只要**有任一行**是 finding 形态就算 CONCERNS：多行 finding 的续行本来就不匹配，
    # 要求整份输出每行都匹配会把正常结果误判成解析失败。
    if printf '%s' "$out" | grep -qE '^[^[:space:]]+:[0-9]+[[:space:]]'; then
        printf 'CONCERNS\n\n%s\n' "$out"
        return 0
    fi
    return 1
}

# _call_backend <backend> <prompt> [run_cwd]
# 在 run_cwd 里跑指定后端的 reviewer agent，裁决文本打到 stdout。
# prompt 的用法随后端和模式变：claude+range 拼进 /code-review 的参数，其余走 stdin
# （避免大 prompt 撞 ARG_MAX）。
# run_cwd 决定 reviewer 能看到什么：range 审查传只读快照，纯文本审查留空 → 临时空目录。
# 失败时经 _error_reason_record 记下原因（timeout/crash/empty/parse），不留静默挂死。
_call_backend() {
    local backend="$1"
    local prompt="$2"
    local run_cwd="${3:-}"

    check_backend "$backend" || { _error_reason_record crash; return 1; }

    local model use_proxy extra_args
    use_proxy=$(_config_get "${backend}.use_proxy")
    extra_args=$(_config_get "${backend}.extra_args")

    # opencode 的 model 可能被网关注入改写成 <provider>/<model>
    local gw_config=""
    if [[ "$backend" == "opencode" ]]; then
        _opencode_gateway_setup
        model="$_OPENCODE_GW_MODEL"
        gw_config="$_OPENCODE_GW_CONFIG"
    else
        model=$(_config_get "${backend}.model")
    fi

    local ephemeral_cwd=""
    if [[ -z "$run_cwd" ]]; then
        run_cwd=$(mktemp -d "${TMPDIR:-/tmp}/sparring-review-cwd.XXXXXX")
        ephemeral_cwd="$run_cwd"
    fi

    # 喂给后端的输入：range 模式下 claude 拿附加指令、opencode 拿完整方法论 + 指令。
    local payload="$prompt"
    if [[ "$_RV_MODE" == "range" && "$backend" == "opencode" ]]; then
        local methodology
        if ! methodology=$(_adversarial_prompt); then
            [[ -n "$ephemeral_cwd" ]] && rm -rf "$ephemeral_cwd"
            _error_reason_record crash
            return 1
        fi
        payload="${methodology}"$'\n\n---\n\n'
        payload="${payload}审查强度 ${_RV_LEVEL}：$(_level_directive "$_RV_LEVEL")"$'\n\n'
        payload="${payload}$(_range_review_prompt "$_RV_RANGE" "$_RV_RIGHT")"$'\n\n'
        payload="${payload}${prompt}"
    elif [[ "$_RV_MODE" != "range" ]]; then
        payload="$(_reviewer_role_prompt)"$'\n'"$prompt"
    fi

    AGENT_CMD=()
    AGENT_STDIN=""
    case "$backend" in
        claude)   _agent_cmd_claude "$model" "$payload" ;;
        opencode) _agent_cmd_opencode "$model" "$payload" ;;
    esac
    # shellcheck disable=SC2206  # 有意按空格拆成多个参数
    [[ -n "$extra_args" ]] && AGENT_CMD+=($extra_args)

    local -a envs=()
    [[ "$use_proxy" != "true" ]] && envs+=("HTTP_PROXY=" "HTTPS_PROXY=")
    [[ -n "$gw_config" ]] && envs+=("OPENCODE_CONFIG=${gw_config}")

    local prompt_file output_file log_file
    prompt_file=$(mktemp "${TMPDIR:-/tmp}/sparring-prompt.XXXXXX")
    output_file=$(mktemp "${TMPDIR:-/tmp}/sparring-out.XXXXXX")
    log_file=$(mktemp "${TMPDIR:-/tmp}/sparring-log.XXXXXX")
    # AGENT_STDIN 为空时写空文件：CLI 读到即时 EOF，不会挂在等输入上
    printf '%s' "$AGENT_STDIN" > "$prompt_file"

    # 清理：每个 return 前显式 rm。不用 trap RETURN —— 本函数在
    # result=$(_call_backend ...) 子 shell 里跑且脚本 set -u；RETURN trap 是全局状态，
    # 会在外层 call_reviewer 返回时再次触发，那里 $_cleanup 未定义 → unbound variable。
    local _cleanup="rm -f \"$prompt_file\" \"$output_file\" \"$log_file\""
    [[ -n "$ephemeral_cwd" ]] && _cleanup="$_cleanup; rm -rf \"$ephemeral_cwd\""
    [[ -n "$gw_config" ]] && _cleanup="$_cleanup; rm -f \"$gw_config\""

    local label timeout_s max_attempts
    label=$(reviewer_label_for_backend "$backend")
    timeout_s=$(_agent_timeout)
    max_attempts=$(_agent_attempts)
    echo -e "${DIM}  使用 ${label} | 模型: ${model:-default} | 工作目录: ${run_cwd}${NC}" >&2
    [[ -n "$gw_config" ]] && echo -e "${DIM}  经 opencode.base_url 网关（临时配置，用完删）${NC}" >&2

    local i ok=false rc=0 last_rc=0
    _heartbeat_start "$label"
    for i in $(seq 1 "$max_attempts"); do
        rc=0
        ( cd "$run_cwd" && _timeout_cmd "$timeout_s" \
                env ${envs[@]+"${envs[@]}"} "${AGENT_CMD[@]}" \
                < "$prompt_file" > "$output_file" 2>"$log_file" ) || rc=$?
        if [[ $rc -eq 0 ]]; then
            ok=true
            break
        fi
        last_rc=$rc
        # 超时不重试：超时几乎总是"审查体量/深度 > 时限"的确定性问题，
        # 重试只会原样再烧一遍时限，直接交给降级链或报错
        [[ $rc -eq 124 ]] && break
        if [[ $i -lt $max_attempts ]]; then
            echo -e "${DIM}  ${backend} 调用失败（退出码 ${rc}），重试 ($i/$max_attempts)...${NC}" >&2
            sleep 2
        fi
    done
    _heartbeat_stop

    if [[ "$ok" != true ]]; then
        local err_output
        err_output=$(tail -c 400 "$log_file" 2>/dev/null || true)
        eval "$_cleanup"
        if [[ $last_rc -eq 124 ]]; then
            _error_reason_record timeout
            echo -e "${RED}错误: ${backend} 超时 ${timeout_s}s，已杀掉整个进程组（超时不重试）${NC}" >&2
        else
            _error_reason_record crash
            echo -e "${RED}错误: ${backend} 调用失败，退出码 ${last_rc} (共 ${max_attempts} 次尝试)${NC}" >&2
        fi
        [[ -n "$err_output" ]] && echo -e "${DIM}  错误信息: ${err_output}${NC}" >&2
        return 1
    fi

    local result
    result=$(_strip_agent_noise < "$output_file")
    eval "$_cleanup"

    if [[ "$result" != *[![:space:]]* ]]; then
        _error_reason_record empty
        echo -e "${RED}错误: ${backend} 返回空结果${NC}" >&2
        return 1
    fi

    # claude 的 range 审查走原生 /code-review，输出格式跟统一契约不同，这里翻译
    if [[ "$backend" == "claude" && "$_RV_MODE" == "range" ]]; then
        local normalized
        if ! normalized=$(_normalize_code_review_output "$result" "$_RV_LEVEL"); then
            _error_reason_record parse
            echo -e "${RED}错误: 无法解析 claude /code-review 的输出${NC}" >&2
            echo -e "${DIM}  原始输出前 200 字符: ${result:0:200}${NC}" >&2
            return 1
        fi
        result="$normalized"
    fi

    printf '%s\n' "$result"
}

# call_reviewer <prompt> [run_cwd]
call_reviewer() {
    local prompt="$1"
    local run_cwd="${2:-}"
    local primary fallback
    primary=$(get_review_backend) || return 1
    fallback=$(get_review_backend_fallback) || return 1

    local result rc=0
    result=$(_call_backend "$primary" "$prompt" "$run_cwd") || rc=$?
    if [[ $rc -eq 0 ]]; then
        _reviewer_state_record "$primary" primary
        echo "$result"
        return 0
    fi

    if [[ -z "$fallback" ]]; then
        _reviewer_state_record "$primary" primary
        return $rc
    fi

    if [[ "$fallback" == "$primary" ]]; then
        echo -e "${DIM}  (fallback 与主 backend 相同: ${primary}，跳过降级)${NC}" >&2
        _reviewer_state_record "$primary" primary
        return $rc
    fi

    local primary_label fallback_label
    primary_label=$(reviewer_label_for_backend "$primary")
    fallback_label=$(reviewer_label_for_backend "$fallback")
    echo -e "${YELLOW}⚠ 主 backend ${primary_label} 调用失败，降级到 ${fallback_label}...${NC}" >&2
    # 降级前先记 primary 失败，主备均失败时状态文件仍保留完整尝试链
    _reviewer_state_record "$primary" primary

    if result=$(_call_backend "$fallback" "$prompt" "$run_cwd"); then
        _reviewer_state_record "$fallback" fallback
        echo "$result"
        return 0
    fi

    _reviewer_state_record "$fallback" fallback
    echo -e "${RED}错误: 主备 backend 均失败 (${primary_label} → ${fallback_label})${NC}" >&2
    return 1
}

# 把本次尝试的后端和路径（primary/fallback）追加到调用方指定的状态文件，
# 文件按行保留完整尝试链（如降级时: "claude primary" + "opencode fallback"），
# 末行即最终实际使用的后端。call_reviewer 通常在命令替换 subshell 里运行，
# 变量传不回父进程——review_adhoc 用它拿到「实际后端 / 是否降级」写执行日志。
# 未设置状态文件（task 制路径）时是 no-op；写失败静默，不影响 review。
_reviewer_state_record() {
    [[ -n "${SPARRING_BACKEND_STATE_FILE:-}" ]] || return 0
    printf '%s %s\n' "$1" "$2" >> "$SPARRING_BACKEND_STATE_FILE" 2>/dev/null || true
}

# ─── 一次性 ad-hoc 审查 ──────────────────────────────────────
# 两种输入形态：
#   --range <git-range>   在只读快照里做 agent 式审查：reviewer 自己跑 git diff、按需读文件
#   stdin / 参数纯文本     审一段结论或方案，reviewer 在空目录里裁决
# 不再接收 diff 文本。把 diff 塞进 prompt 是上一代做法，体量门禁、分片建议、
# 超时跑飞都是它带来的；检测到 diff 就硬报错，让调用方改用 --range。

# range 右端的 commit：a...b / a..b 取 b；没有 ".." 的单个 ref 一律用 HEAD
# （`git diff <ref>` 比的是 ref→工作区，在快照里等于空 diff，所以它不能当右端）。
_range_right_ref() {
    local range="$1" right=""
    case "$range" in
        *...*) right="${range##*...}" ;;
        *..*)  right="${range##*..}" ;;
    esac
    [[ -z "$right" ]] && right="HEAD"
    printf '%s' "$right"
}

# range 的总变更行数（执行日志用）。用 --numstat 而不是解析 --stat 的尾行文案：
# 数字直接能加。二进制文件那一列是 "-"，不计入。
_range_changed_lines() {
    git diff --numstat "$1" 2>/dev/null | awk '
        { if ($1 ~ /^[0-9]+$/) a += $1; if ($2 ~ /^[0-9]+$/) b += $2 }
        END { print a + b + 0 }'
}

# 只读快照：git worktree add --detach 到临时目录，reviewer 的 cwd 指向它，审完就删。
# 注意 worktree 跟主仓库共用对象库和 ref，而 reviewer 手里有 Bash —— 工具层面挡不住它写东西。
# 这里的"只读"是 detached（不动任何分支）+ 审完即删，不是文件系统权限。
_REVIEW_SNAPSHOT=""

_review_snapshot_create() {
    local ref="$1" parent
    parent=$(mktemp -d "${TMPDIR:-/tmp}/sparring-snapshot.XXXXXX") || return 1
    # worktree add 要求目标路径不存在，所以建在 mktemp 目录的子路径下
    if ! git worktree add --detach "${parent}/tree" "$ref" >/dev/null 2>&1; then
        echo -e "${RED}错误: 无法为 ${ref} 创建 worktree 快照${NC}" >&2
        rm -rf "$parent" 2>/dev/null || true
        return 1
    fi
    _REVIEW_SNAPSHOT="${parent}/tree"
}

# 幂等：没建过、已删过、目录已消失都安全。
_review_snapshot_cleanup() {
    [[ -n "$_REVIEW_SNAPSHOT" ]] || return 0
    local dir="$_REVIEW_SNAPSHOT"
    _REVIEW_SNAPSHOT=""
    git worktree remove --force "$dir" >/dev/null 2>&1 || true
    rm -rf "$(dirname "$dir")" 2>/dev/null || true
    # remove 失败（比如目录已被手删）时留下的登记项由 prune 收尾
    git worktree prune >/dev/null 2>&1 || true
}

# 内容是不是 diff 文本（首列 "diff --git " 或 "--- a/"）
_looks_like_diff() {
    printf '%s' "$1" | grep -qE '^(diff --git |--- a/)'
}

# range 模式给 reviewer 的指令。审查对象是仓库本身，不是一段文本，
# 所以这里给的是"去哪看、怎么看"，不是 diff 内容。
_range_review_prompt() {
    local range="$1" right="$2"
    cat <<PROMPTEOF
本次审查对象是当前 git 仓库的一段改动，range: ${range}

你的工作目录是这个仓库的只读快照（detached 在 ${right}）。请自己动手看：
- 先跑 \`git diff ${range}\` 看全部改动；体量大就先 \`git diff --stat ${range}\` 摸分布，再按文件/目录分批看
- 需要上下文就直接读文件、grep 调用方，不要只盯 diff 猜上下文
- 跳过 lockfile、构建产物、生成代码、二进制资源，它们不是审查对象
- 快照是一次性的，不要改动任何文件
PROMPTEOF
}
# ─── review 执行日志 ─────────────────────────────────────────
# 每次 ad-hoc review 在 ${XDG_STATE_HOME:-~/.local/state}/sparring/ 追加一行
# JSONL（review-YYYYMMDD.jsonl，按天分文件），记录实际后端/是否降级/耗时/裁决，
# 供事后排查「超时跑飞」「降级频率」这类问题——review 输出本身只走 stdout 不落盘。
# config review.log_retention_days 控制保留天数（默认 7，0 = 完全禁用）。
# 日志属于旁路：任何失败（目录建不了/jq 出错/磁盘满）都静默，绝不影响 review。

_review_log_dir() {
    printf '%s/sparring' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

_review_log_retention_days() {
    local days
    days=$(_config_get review.log_retention_days)
    [[ "$days" =~ ^[0-9]+$ ]] || days=7
    printf '%s' "$days"
}

# _review_log_append <exit_code> <verdict> <title> <input_lines> <duration_s> <backend> <via> [mode] [range] [level] [error_reason]
# mode: range（审 git range）| text（审一段文本）；range 字段无则 null。
# error_reason: timeout|crash|empty|parse，只在 verdict=ERROR 时有值——排查"静默挂了"
# 的第一手依据，没有它只能看到一个 exit 1。
_review_log_append() {
    local exit_code="$1" verdict="$2" title="$3" input_lines="$4" duration_s="$5" backend="$6" via="$7"
    local mode="${8:-text}" range="${9:-}" level="${10:-}" error_reason="${11:-}"
    local days
    days=$(_review_log_retention_days)
    [[ "$days" == "0" ]] && return 0
    local dir
    dir=$(_review_log_dir)
    mkdir -p "$dir" 2>/dev/null || return 0
    # 写入顺带清理过期日志；按文件 mtime 判断，删整文件比按行过滤简单且无半写风险
    find "$dir" -maxdepth 1 -name 'review-*.jsonl' -type f -mtime +"$days" -delete 2>/dev/null || true
    # 数字字段兜底成合法 JSON，避免上游异常值让 jq 报错丢日志
    [[ "$exit_code" =~ ^[0-9]+$ ]] || exit_code=1
    [[ "$input_lines" =~ ^[0-9]+$ ]] || input_lines=0
    [[ "$duration_s" =~ ^[0-9]+$ ]] || duration_s=0
    jq -nc \
        --arg ts "$(date '+%Y-%m-%dT%H:%M:%S%z')" \
        --arg title "$title" \
        --arg backend "${backend:-unknown}" \
        --arg via "${via:-unknown}" \
        --arg verdict "$verdict" \
        --arg mode "$mode" \
        --arg range "$range" \
        --arg level "$level" \
        --arg error_reason "$error_reason" \
        --argjson input_lines "$input_lines" \
        --argjson duration_s "$duration_s" \
        --argjson exit_code "$exit_code" \
        '{ts: $ts, title: $title, mode: $mode, range: (if $range == "" then null else $range end),
          level: (if $level == "" then null else $level end),
          input_lines: $input_lines, backend: $backend,
          via: $via, duration_s: $duration_s, exit_code: $exit_code, verdict: $verdict,
          error_reason: (if $error_reason == "" then null else $error_reason end)}' \
        >> "${dir}/review-$(date +%Y%m%d).jsonl" 2>/dev/null || true
}

# _review_run <prompt> <run_cwd> <title> <mode> <range> <input_lines>
# range 模式和文本模式共用的尾段：调 reviewer → 打印结果 → 落执行日志 → 按裁决定退出码。
_review_run() {
    local prompt="$1" run_cwd="$2" title="$3" mode="$4" range="$5" input_lines="$6"

    # 执行日志采集：起始时间 + 实际后端状态文件 + 失败原因文件
    # （call_reviewer 在命令替换 subshell 里跑，靠文件把 backend/via/reason 传回来）
    local _log_t0 _log_state _log_reason_file
    _log_t0=$(date +%s)
    _log_state=$(mktemp "${TMPDIR:-/tmp}/sparring-review-state.XXXXXX" 2>/dev/null) || _log_state=""
    [[ -n "$_log_state" ]] && SPARRING_BACKEND_STATE_FILE="$_log_state"
    _log_reason_file=$(mktemp "${TMPDIR:-/tmp}/sparring-review-reason.XXXXXX" 2>/dev/null) || _log_reason_file=""
    [[ -n "$_log_reason_file" ]] && SPARRING_ERROR_REASON_FILE="$_log_reason_file"

    local result rc=0
    result=$(call_reviewer "$prompt" "$run_cwd") || rc=$?

    local _log_backend="" _log_via="" _log_dur _log_reason=""
    if [[ -n "$_log_state" && -s "$_log_state" ]]; then
        # 状态文件是尝试链（每行一次尝试），末行 = 最终实际使用的后端
        read -r _log_backend _log_via <<< "$(tail -n 1 "$_log_state" 2>/dev/null)" || true
    fi
    if [[ -n "$_log_reason_file" && -s "$_log_reason_file" ]]; then
        _log_reason=$(tr -d '\n' < "$_log_reason_file" 2>/dev/null) || _log_reason=""
    fi
    [[ -n "$_log_state" ]] && rm -f "$_log_state" 2>/dev/null
    [[ -n "$_log_reason_file" ]] && rm -f "$_log_reason_file" 2>/dev/null
    unset SPARRING_BACKEND_STATE_FILE SPARRING_ERROR_REASON_FILE
    _log_dur=$(( $(date +%s) - _log_t0 ))

    if [[ $rc -ne 0 ]]; then
        # 原因文件没写上说明是调用层之外的失败（比如 backend 名非法），归 crash
        [[ -z "$_log_reason" ]] && _log_reason="crash"
        echo -e "${RED}✗ review 未完成，原因: ${_log_reason}${NC}" >&2
        _review_log_append "$rc" ERROR "$title" "$input_lines" "$_log_dur" \
            "$_log_backend" "$_log_via" "$mode" "$range" "$_RV_LEVEL" "$_log_reason"
        return $rc
    fi

    printf '%s\n' "$result"

    # 退出码反映结论。严格匹配列首大写裁决词（reviewer prompt 强制此格式），
    # 不用 -i、不容前导空格，避免审查正文里的 approve/concerns 误命中。
    # 解析不出明确裁决时 return 1（按错误处理，绝不默认放行 — 触发铁律兜底）。
    local verdict
    verdict=$(printf '%s' "$result" | grep -m1 -oE '^(APPROVE|CONCERNS)' || true)
    case "$verdict" in
        APPROVE)
            _review_log_append 0 APPROVE "$title" "$input_lines" "$_log_dur" \
                "$_log_backend" "$_log_via" "$mode" "$range" "$_RV_LEVEL" ""
            return 0
            ;;
        CONCERNS)
            _review_log_append 2 CONCERNS "$title" "$input_lines" "$_log_dur" \
                "$_log_backend" "$_log_via" "$mode" "$range" "$_RV_LEVEL" ""
            return 2
            ;;
        *)
            echo -e "${YELLOW}⚠ 无法从 reviewer 输出解析出 APPROVE/CONCERNS 裁决，按调用错误处理（exit 1）${NC}" >&2
            _review_log_append 1 ERROR "$title" "$input_lines" "$_log_dur" \
                "$_log_backend" "$_log_via" "$mode" "$range" "$_RV_LEVEL" parse
            return 1
            ;;
    esac
}

# 在只读快照里审一段 git range
_review_range() {
    local range="$1" title="$2" level="$3"

    if ! git rev-parse --git-dir >/dev/null 2>&1; then
        echo -e "${RED}错误: --range 需要在 git 仓库里执行${NC}" >&2
        return 1
    fi
    # range 合法性直接拿 git 验，别自己解析
    if ! git diff --stat "$range" >/dev/null 2>&1; then
        echo -e "${RED}错误: 无效的 git range: ${range}${NC}" >&2
        echo "  例: sparring review --range origin/main...HEAD" >&2
        return 1
    fi

    local right
    right=$(_range_right_ref "$range")
    if ! git rev-parse --verify --quiet "${right}^{commit}" >/dev/null 2>&1; then
        echo -e "${DIM}  (range 右端 ${right} 解析不出 commit，快照回退到 HEAD)${NC}" >&2
        right="HEAD"
    fi

    local input_lines
    input_lines=$(_range_changed_lines "$range")

    # 快照清理走 trap：审查中途被 Ctrl-C / kill(TERM) 时也要收干净，
    # 只靠 per-return 清理的话中断路径会漏。实测 bash 3.2 下命令替换子 shell
    # 不触发 EXIT trap，所以 call_reviewer 那层的 $(...) 不会误删快照。
    trap '_review_snapshot_cleanup' EXIT INT TERM
    if ! _review_snapshot_create "$right"; then
        trap - EXIT INT TERM
        return 1
    fi
    echo -e "${DIM}  只读快照: ${_REVIEW_SNAPSHOT} (detached ${right})${NC}" >&2

    # 审查上下文交给后端层：claude 拼进 /code-review 的参数，opencode 拼进注入的方法论
    _RV_MODE="range"
    _RV_RANGE="$range"
    _RV_RIGHT="$right"
    _RV_LEVEL="$level"

    # 这里只给"附加审查指令"——去哪看、怎么看由各后端自己补：claude 的 /code-review
    # 自带方法论，opencode 由 prompts/adversarial-review.md 注入。
    local prompt="请特别注意：只报本次改动引入或暴露的真实问题，每条都要给出 file:line 和一个具体的失败场景。"
    [[ -n "$title" ]] && prompt="审查主题：${title}"$'\n'"$prompt"
    local conventions
    conventions=$(load_review_conventions)
    [[ -n "$conventions" ]] && prompt="$prompt"$'\n\n本项目的 Review 约定：\n'"$conventions"

    local rc=0
    _review_run "$prompt" "$_REVIEW_SNAPSHOT" "$title" range "$range" "$input_lines" || rc=$?

    _review_snapshot_cleanup
    trap - EXIT INT TERM
    return $rc
}

review_adhoc() {
    local title=""
    local content=""
    local range=""
    local level=""
    local level_explicit=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --title)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}错误: --title 需要一个参数${NC}" >&2
                    return 1
                fi
                title="$2"
                shift 2
                ;;
            --range)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    echo -e "${RED}错误: --range 需要一个 git range，例: origin/main...HEAD${NC}" >&2
                    return 1
                fi
                range="$2"
                shift 2
                ;;
            --level)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    echo -e "${RED}错误: --level 需要一个参数（${REVIEW_LEVELS}）${NC}" >&2
                    return 1
                fi
                if ! level=$(_normalize_level "$2"); then
                    echo -e "${RED}错误: 不支持的 level: '$2'（仅支持 ${REVIEW_LEVELS}）${NC}" >&2
                    return 1
                fi
                level_explicit=true
                shift 2
                ;;
            -h|--help)
                cat >&2 <<'USAGE'
用法: sparring review [--title <主题>] [--level <强度>] (--range <git-range> | [<内容>])
  reviewer 是个 agent：给它 range 它自己去仓库里查，给它文本它就事论事裁决。
  退出码: 0=APPROVE  2=CONCERNS  1=调用错误

两种输入形态:
  --range <git-range>   审当前仓库的一段改动（推荐）。会 git worktree 建一个只读快照，
                        reviewer 在快照里自己跑 git diff、读文件、追调用方上下文，
                        审完自动删快照。不再有 diff 体量限制，也不需要分片。
  <内容> / stdin        审一段结论或方案文本（不建快照）。

  ⚠ 不再接收 diff 文本（`git diff | sparring review` 会直接报错）——改用 --range。

--level <低到高: low / medium / high / xhigh>  默认 medium (config: review.level)
  low 少而准，xhigh 穷尽式（更慢、噪音更多）。只对 --range 有意义。

后端 (config review.backend，默认 claude；fallback 默认 opencode):
  claude    Claude Code 原生 /code-review，开 Bash + 只读工具，禁写类/联网工具
  opencode  opencode run --agent plan，方法论由 prompts/adversarial-review.md 注入

进程管理（每次 review 只有三种结局，不存在静默挂死）:
  APPROVE / CONCERNS / 带原因的 ERROR（timeout|crash|empty|parse）
  超时（config review.timeout，默认 600s）杀掉整个进程组，不留孤儿进程；
  运行期间每 15s 往 stderr 打一行心跳。

执行日志（排查超时/降级用）:
  每次调用追加一行 JSONL 到 ~/.local/state/sparring/review-YYYYMMDD.jsonl
  （字段: ts/title/mode/range/level/input_lines/backend/via/duration_s/exit_code/
   verdict/error_reason），默认保留 7 天（config: review.log_retention_days，0 = 禁用）。

示例:
  sparring review --range origin/main...HEAD
  sparring review --range HEAD~3..HEAD --level high --title "登录重构"
  echo "<上下文+结论>" | sparring review
USAGE
                return 0
                ;;
            *)
                content="${content:+$content }$1"
                shift
                ;;
        esac
    done

    # range 模式一律不读 stdin。非交互环境（CI / agent 子进程）里 stdin 常是个
    # 永远不关闭的管道，`cat` 会一直阻塞 —— 实测 `sparring review --range X` 直接卡死。
    # range 的输入本来就来自 git，不需要 stdin；真有人管道送了东西就提醒一句被忽略了。
    # 未显式指定就取配置默认（config review.level，内置 medium）
    if [[ -z "$level" ]]; then
        level=$(get_review_level) || return 1
    fi

    if [[ -n "$range" ]]; then
        if [[ "$content" == *[![:space:]]* ]]; then
            echo -e "${RED}错误: --range 和文本内容不能同时给${NC}" >&2
            echo "  审 range 用: sparring review --range origin/main...HEAD" >&2
            echo "  审文本用:   echo '<内容>' | sparring review" >&2
            return 1
        fi
        [[ -p /dev/stdin ]] && echo -e "${YELLOW}⚠ --range 模式不读 stdin，管道里的内容已忽略${NC}" >&2
        _review_range "$range" "$title" "$level"
        return $?
    fi

    # 追加 stdin（管道/重定向）
    if [[ ! -t 0 ]]; then
        local piped
        piped=$(cat)
        if [[ -n "$piped" ]]; then
            if [[ -n "$content" ]]; then
                content="$content"$'\n\n'"$piped"
            else
                content="$piped"
            fi
        fi
    fi

    # 注意：不要用 ${content//[[:space:]]/} 判空——bash 对大字符串做全量
    # pattern 删除是灾难级慢（22KB diff 实测卡死数十秒），glob 单遍短路即可
    if [[ "$content" != *[![:space:]]* ]]; then
        echo -e "${RED}错误: 没有收到要审查的内容（用 --range、参数或 stdin 传入）${NC}" >&2
        return 1
    fi

    # diff 文本硬拒：不做静默兼容，直接指到 --range
    if _looks_like_diff "$content"; then
        echo -e "${RED}错误: sparring review 不再接收 diff 文本${NC}" >&2
        echo "  改用: sparring review --range origin/main...HEAD" >&2
        echo "  reviewer 会在只读快照里自己跑 git diff，不再有体量上限，也不用分片。" >&2
        return 1
    fi

    # 文本模式没有 level 这回事：claude 走不到 /code-review，opencode 也没有代码可挖深。
    # 记 null 而不是记一个没生效的值，免得日志读起来像"审过 high 了"。
    $level_explicit && echo -e "${YELLOW}⚠ --level 只对 --range 生效，本次审的是文本，已忽略${NC}" >&2
    _RV_MODE="text"
    _RV_RANGE=""
    _RV_LEVEL=""

    local prompt="以下是需要你审查的内容（是一段结论/方案文本，不是代码仓库，就事论事审）：

${content}"
    [[ -n "$title" ]] && prompt="【审查主题】${title}"$'\n\n'"$prompt"
    local conventions
    conventions=$(load_review_conventions)
    [[ -n "$conventions" ]] && prompt="$prompt"$'\n\n## Review 约定\n'"$conventions"

    local input_lines
    input_lines=$(printf '%s' "$prompt" | awk 'END { print NR }')
    _review_run "$prompt" "" "$title" text "" "$input_lines"
}

# ─── 初始化 ─────────────────────────────────────────────────

init_workflow() {
    mkdir -p "${PLANS_DIR}"
    mkdir -p "${REVIEW_JOBS_DIR}"

    cat > "${WORKFLOW_DIR}/.gitignore" <<'EOF'
*
!.gitignore
EOF

    echo -e "${GREEN}✓ 工作流目录初始化完成: ${WORKFLOW_DIR}${NC}"
    echo ""
    echo "提示: .workflow 目录默认被 git 忽略"
    echo "      如需团队共享，请修改 ${WORKFLOW_DIR}/.gitignore"
}

# ─── 创建任务 ────────────────────────────────────────────────

create_task() {
    local task_name="${1:-}"
    local executor="${2:-}"

    if [[ -z "$task_name" ]]; then
        echo -e "${RED}错误: 请提供任务名称${NC}"
        echo "用法: sparring create <task-name> <claude|cursor>"
        exit 1
    fi

    validate_task_name "$task_name"

    if [[ -z "$executor" ]]; then
        executor="claude"
    fi

    validate_executor "$executor"

    if [[ ! -d "${PLANS_DIR}" ]]; then
        init_workflow
    fi

    local backend
    backend=$(get_review_backend) || exit 1
    local reviewer
    reviewer=$(reviewer_name_for_backend "$backend")
    local task_id
    task_id="$(date +%Y%m%d-%H%M%S)-${task_name}"
    local task_dir="${PLANS_DIR}/${task_id}"

    mkdir -p "${task_dir}"

    jq -n \
        --arg id "$task_id" \
        --arg name "$task_name" \
        --arg exec "$executor" \
        --arg rev "$reviewer" \
        --arg ts "$(date -Iseconds)" \
        '{
            task_id: $id,
            task_name: $name,
            executor: $exec,
            reviewer: $rev,
            status: "proposal",
            created_at: $ts,
            steps: {
                proposal: "pending",
                proposal_review: "pending",
                implementation: "pending",
                code_review: "pending",
                approved: "pending"
            }
        }' > "${task_dir}/meta.json"

    cat > "${task_dir}/task.md" <<EOF
# Task: ${task_name}

## 任务描述
[在此描述任务需求和目标]

## 背景
[提供必要的背景信息]

## 预期结果
[描述预期的交付结果]

---
**执行者**: ${executor}
**观察者**: ${reviewer}
EOF

    echo -e "${GREEN}✓ 任务创建成功: ${task_id}${NC}"
    echo -e "${BLUE}任务目录: ${task_dir}${NC}"
    echo -e "${YELLOW}执行者: ${executor}  观察者: ${reviewer}${NC}"
    echo -e "${DIM}审查后端: ${backend}${NC}"
    echo ""
    echo "下一步:"
    echo "  1. 编辑任务描述: ${task_dir}/task.md"
    echo "  2. 执行者开始写方案: sparring propose ${task_id}"
}

# ─── 写方案 ──────────────────────────────────────────────────

propose() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    local executor
    executor=$(jq -r '.executor' "${task_dir}/meta.json")

    echo -e "${BLUE}=== 方案阶段 ===${NC}"
    echo -e "${YELLOW}执行者: ${executor}${NC}"
    echo ""
    echo "请为任务 ${task_id} 编写技术方案。"
    echo ""
    echo "  任务描述: ${task_dir}/task.md"
    echo "  输出文件: ${task_dir}/proposal.md"
    echo ""
    echo "方案应包含: 技术设计、实现步骤、潜在风险、测试计划"

    update_meta "$task_dir" '.steps.proposal = "in_progress"'
}

# ─── 自动 Review 方案 ────────────────────────────────────────

review_proposal_bg() {
    local task_id="${1:-}"
    if [[ -z "$task_id" ]]; then
        echo -e "${RED}错误: 请提供 task-id${NC}"
        echo "用法: sparring review-proposal-bg <task-id>"
        return 1
    fi
    start_background_review "proposal" "$task_id"
}

review_proposal() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    local backend
    backend=$(get_review_backend) || return 1

    if [[ ! -f "${task_dir}/proposal.md" ]]; then
        echo -e "${RED}错误: 方案文件不存在，请先编写 ${task_dir}/proposal.md${NC}"
        return 1
    fi

    local reviewer
    reviewer=$(jq -r '.reviewer' "${task_dir}/meta.json")
    [[ -z "$reviewer" || "$reviewer" == "null" ]] && reviewer=$(reviewer_name_for_backend "$backend")
    local reviewer_label
    reviewer_label=$(reviewer_label_for_backend "$backend")
    local review_count
    review_count=$(find "${task_dir}" -name "proposal-review-*.md" 2>/dev/null | wc -l)
    local review_num=$((review_count + 1))

    echo -e "${BLUE}=== 方案 Review (第 ${review_num} 轮) ===${NC}"
    echo -e "${YELLOW}观察者: ${reviewer_label}${NC}"
    echo ""

    local conventions
    conventions=$(load_review_conventions)
    local conventions_section=""
    [[ -n "$conventions" ]] && conventions_section=$'\n\n## Review 约定\n'"$conventions"

    # 方案正文不内联进 prompt：reviewer 的 cwd 就是项目根，让它自己读方案、
    # 也顺手对着真实代码核方案里的前提是否成立。
    local prompt="你正在 review 一份技术方案。

任务: $(jq -r '.task_name' "${task_dir}/meta.json")
方案文件: ${task_dir}/proposal.md

请自己读方案文件；方案里提到的现有代码、模块、约定，直接在当前工作目录（项目根）里核实，
不要只按方案的自述判断。${conventions_section}

重点: 架构合理性、可行性、边界情况、安全性。
只提真正有问题的点，不要提远期优化建议或假设性场景防御。请用中文简洁回复。"

    echo -e "${DIM}正在调用 ${reviewer_label} (${backend} backend) review...${NC}"

    local review_result
    if review_result=$(call_reviewer "$prompt" "$PROJECT_ROOT"); then
        echo "$review_result" > "${task_dir}/proposal-review-${review_num}.md"
        echo ""
        echo -e "${GREEN}Review 结果:${NC}"
        echo "$review_result"
        echo ""

        if echo "$review_result" | grep -qi "APPROVE"; then
            echo -e "${GREEN}✓ 方案 Review 通过！${NC}"
            update_meta "$task_dir" '.steps.proposal_review = "approved"'
            sync_to_issue "$task_dir" "${reviewer_label}" "Proposal Review #${review_num} — APPROVED" "$review_result"
        else
            echo -e "${YELLOW}⚠ 有修改意见，请执行者处理后重新 review${NC}"
            update_meta "$task_dir" '.steps.proposal_review = "needs_revision"'
            sync_to_issue "$task_dir" "${reviewer_label}" "Proposal Review #${review_num} — NEEDS REVISION" "$review_result"
        fi
    else
        echo -e "${YELLOW}⚠ ${reviewer_label} 调用失败，降级为手动 review${NC}"
        echo ""
        echo "请手动 review: ${task_dir}/proposal.md"
        echo "并将结果保存到: ${task_dir}/proposal-review-${review_num}.md"
        update_meta "$task_dir" '.steps.proposal_review = "manual"'
    fi
}

# ─── 批准方案 ────────────────────────────────────────────────

approve_proposal() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"

    update_meta "$task_dir" \
        '.steps.proposal = "done" | .steps.proposal_review = "approved" | .steps.implementation = "ready" | .status = "implementation"'

    local executor
    executor=$(jq -r '.executor' "${task_dir}/meta.json")
    echo -e "${GREEN}✓ 方案已批准${NC}"
    echo -e "${BLUE}=== 进入实现阶段 ===${NC}"
    echo -e "${YELLOW}执行者 (${executor}) 可以开始实现代码${NC}"
    echo ""
    echo "下一步: sparring implement ${task_id}"

    sync_to_issue "$task_dir" "Workflow" "Proposal Approved" "方案已批准，进入实现阶段。执行者: **${executor}**"
}

# ─── 实现代码 ────────────────────────────────────────────────

implement() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    local executor
    executor=$(jq -r '.executor' "${task_dir}/meta.json")

    echo -e "${BLUE}=== 实现阶段 ===${NC}"
    echo -e "${YELLOW}执行者: ${executor}${NC}"
    echo ""
    echo "请根据方案实现代码。"
    echo ""
    echo "  方案文件: ${task_dir}/proposal.md"
    echo ""
    echo "实现完成后直接跑: sparring review-code ${task_id}"
    echo "  (reviewer 会自己在项目里跑 git diff 看未提交改动，不用先导出 diff 文件)"

    update_meta "$task_dir" '.steps.implementation = "in_progress"'
}

# ─── 自动 Review 代码 ────────────────────────────────────────

review_code_bg() {
    local task_id="${1:-}"
    if [[ -z "$task_id" ]]; then
        echo -e "${RED}错误: 请提供 task-id${NC}"
        echo "用法: sparring review-code-bg <task-id>"
        return 1
    fi
    start_background_review "code" "$task_id"
}

review_code() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    local backend
    backend=$(get_review_backend) || return 1

    local reviewer
    reviewer=$(jq -r '.reviewer' "${task_dir}/meta.json")
    [[ -z "$reviewer" || "$reviewer" == "null" ]] && reviewer=$(reviewer_name_for_backend "$backend")
    local reviewer_label
    reviewer_label=$(reviewer_label_for_backend "$backend")
    local review_count
    review_count=$(find "${task_dir}" -name "code-review-*.md" 2>/dev/null | wc -l)
    local review_num=$((review_count + 1))

    echo -e "${BLUE}=== 代码 Review (第 ${review_num} 轮) ===${NC}"
    echo -e "${YELLOW}观察者: ${reviewer_label}${NC}"
    echo ""

    # 审的是工作区里还没提交的改动，所以 reviewer 直接在项目根（活树）里跑，不建快照。
    if ! (cd "$PROJECT_ROOT" && git rev-parse --git-dir >/dev/null 2>&1); then
        echo -e "${YELLOW}⚠ ${PROJECT_ROOT} 不是 git 仓库，无法做代码 review${NC}"
        return 1
    fi
    if (cd "$PROJECT_ROOT" && git diff --quiet HEAD 2>/dev/null); then
        echo -e "${YELLOW}⚠ 未检测到未提交的代码改动${NC}"
        echo "  已提交的改动用: sparring review --range <base>...HEAD"
        return 1
    fi

    local conventions
    conventions=$(load_review_conventions)
    local conventions_section=""
    [[ -n "$conventions" ]] && conventions_section=$'\n\n## Review 约定\n'"$conventions"

    # diff 不内联进 prompt：让 reviewer 自己跑，顺带能读改动周边的代码和调用方。
    local prompt="你正在 review 代码实现。

任务: $(jq -r '.task_name' "${task_dir}/meta.json")
方案文件: ${task_dir}/proposal.md（存在的话，先读它，核对实现有没有偏离方案）

你的工作目录就是项目根。请自己动手看：
- \`git status\` + \`git diff HEAD\` 看本次未提交的全部改动
- 按需读文件、grep 调用方，确认改动对周边代码的影响
- 跳过 lockfile、构建产物、生成代码${conventions_section}

重点: 正确性、安全性、边界 case、测试覆盖。
只提真正有问题的点，不要提远期优化建议或假设性场景防御。请用中文简洁回复。"

    echo -e "${DIM}正在调用 ${reviewer_label} (${backend} backend) review...${NC}"

    local review_result
    if review_result=$(call_reviewer "$prompt" "$PROJECT_ROOT"); then
        echo "$review_result" > "${task_dir}/code-review-${review_num}.md"
        echo ""
        echo -e "${GREEN}Code Review 结果:${NC}"
        echo "$review_result"
        echo ""

        if echo "$review_result" | grep -qi "APPROVE"; then
            echo -e "${GREEN}✓ 代码 Review 通过！${NC}"
            update_meta "$task_dir" '.steps.code_review = "approved"'
            sync_to_issue "$task_dir" "${reviewer_label}" "Code Review #${review_num} — APPROVED" "$review_result"
        else
            echo -e "${YELLOW}⚠ 有修改意见，请执行者修复后重新 review${NC}"
            update_meta "$task_dir" '.steps.code_review = "needs_revision"'
            sync_to_issue "$task_dir" "${reviewer_label}" "Code Review #${review_num} — NEEDS REVISION" "$review_result"
        fi
    else
        echo -e "${YELLOW}⚠ ${reviewer_label} 调用失败，降级为手动 review${NC}"
        echo ""
        echo "请手动 review 代码改动"
        echo "并将结果保存到: ${task_dir}/code-review-${review_num}.md"
        update_meta "$task_dir" '.steps.code_review = "manual"'
    fi
}

# ─── 自动 Review 循环 ────────────────────────────────────────

auto_review_proposal() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    local executor
    executor=$(jq -r '.executor' "${task_dir}/meta.json")

    echo -e "${BLUE}=== 自动方案 Review 循环 ===${NC}"

    for round in $(seq 1 $MAX_REVIEW_ROUNDS); do
        echo ""
        echo -e "${DIM}── 第 ${round} 轮 ──${NC}"

        review_proposal "$task_id"

        local status
        status=$(jq -r '.steps.proposal_review' "${task_dir}/meta.json")

        if [[ "$status" == "approved" ]]; then
            echo ""
            echo -e "${GREEN}✓ 方案经过 ${round} 轮 review 后通过！${NC}"
            return 0
        fi

        if [[ "$status" == "manual" ]]; then
            echo -e "${YELLOW}降级为手动模式，请手动处理${NC}"
            return 1
        fi

        if [[ $round -lt $MAX_REVIEW_ROUNDS ]]; then
            echo ""
            echo -e "${YELLOW}执行者 (${executor}) 正在根据反馈修改方案...${NC}"
            # 在 Skill 自动化模式下，执行者会自动处理
            # 在 CLI 手动模式下，需要用户手动修改
            if [[ "${AUTO_MODE:-}" != "true" ]]; then
                echo "请修改方案后重新运行: sparring review-proposal ${task_id}"
                return 0
            fi
        fi
    done

    echo -e "${RED}⚠ ${MAX_REVIEW_ROUNDS} 轮后仍未通过，请人工介入${NC}"
    return 1
}

auto_review_code() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"
    local executor
    executor=$(jq -r '.executor' "${task_dir}/meta.json")

    echo -e "${BLUE}=== 自动代码 Review 循环 ===${NC}"

    for round in $(seq 1 $MAX_REVIEW_ROUNDS); do
        echo ""
        echo -e "${DIM}── 第 ${round} 轮 ──${NC}"

        review_code "$task_id"

        local status
        status=$(jq -r '.steps.code_review' "${task_dir}/meta.json")

        if [[ "$status" == "approved" ]]; then
            echo ""
            echo -e "${GREEN}✓ 代码经过 ${round} 轮 review 后通过！${NC}"
            return 0
        fi

        if [[ "$status" == "manual" ]]; then
            echo -e "${YELLOW}降级为手动模式，请手动处理${NC}"
            return 1
        fi

        if [[ $round -lt $MAX_REVIEW_ROUNDS ]]; then
            echo ""
            echo -e "${YELLOW}执行者 (${executor}) 正在根据反馈修复代码...${NC}"
            if [[ "${AUTO_MODE:-}" != "true" ]]; then
                echo "请修复后重新运行: sparring review-code ${task_id}"
                return 0
            fi
        fi
    done

    echo -e "${RED}⚠ ${MAX_REVIEW_ROUNDS} 轮后仍未通过，请人工介入${NC}"
    return 1
}

# ─── 最终批准 ────────────────────────────────────────────────

approve_final() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"

    update_meta "$task_dir" \
        '.steps.code_review = "approved" | .steps.approved = "yes" | .status = "completed" | .completed_at = "'"$(date -Iseconds)"'"'

    echo -e "${GREEN}✓✓✓ 任务完成！${NC}"
    echo ""
    echo "  方案: ${task_dir}/proposal.md"
    echo "  审查: ${task_dir}/"
    echo ""
    echo -e "${YELLOW}现在可以提交代码:${NC}"
    echo "  git add ."
    echo "  git commit"
    echo "  git push"

    sync_to_issue "$task_dir" "Workflow" "Task Completed" "任务已完成，所有 review 通过。准备提交代码。"
}

# ─── GitHub Issue 工具函数 ─────────────────────────────────────

# 从 git remote 获取 owner/repo
detect_repo() {
    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null) || {
        echo -e "${RED}错误: 无法获取 git remote origin${NC}" >&2
        return 1
    }
    # 支持 SSH 和 HTTPS 格式
    echo "$remote_url" | sed -E 's|.*github\.com[:/]([^/]+/[^/.]+)(\.git)?$|\1|'
}

# 获取 issue 的 project item ID（用于更新看板状态）
get_project_item_id() {
    local issue_number="$1"

    # 没有 project 配置时直接跳过
    [[ -z "$ISSUE_PROJECT_OWNER" || -z "$ISSUE_PROJECT_NUMBER" ]] && return 1

    local repo
    repo=$(detect_repo)

    gh api graphql -f query='
    query($owner: String!, $repo: String!, $number: Int!) {
      repository(owner: $owner, name: $repo) {
        issue(number: $number) {
          projectItems(first: 10) {
            nodes {
              id
              project { number }
            }
          }
        }
      }
    }' -f owner="${ISSUE_PROJECT_OWNER}" -f repo="${repo##*/}" -F number="$issue_number" \
        --jq ".data.repository.issue.projectItems.nodes[] | select(.project.number == ${ISSUE_PROJECT_NUMBER}) | .id" 2>/dev/null
}

# 更新 issue 在 project board 上的状态
update_project_status() {
    local issue_number="$1"
    local target_status="$2"

    local item_id
    item_id=$(get_project_item_id "$issue_number")
    if [[ -z "$item_id" ]]; then
        echo -e "${YELLOW}⚠ 未找到 issue #${issue_number} 在 project 中的条目，跳过状态更新${NC}" >&2
        return 1
    fi

    # 获取 project ID 和 Status 字段 ID
    local project_data
    project_data=$(gh api graphql -f query='
    query($owner: String!, $number: Int!) {
      organization(login: $owner) {
        projectV2(number: $number) {
          id
          field(name: "Status") {
            ... on ProjectV2SingleSelectField {
              id
              options { id name }
            }
          }
        }
      }
    }' -f owner="${ISSUE_PROJECT_OWNER}" -F number="${ISSUE_PROJECT_NUMBER}" 2>/dev/null)

    local project_id
    project_id=$(echo "$project_data" | jq -r '.data.organization.projectV2.id')
    local field_id
    field_id=$(echo "$project_data" | jq -r '.data.organization.projectV2.field.id')
    local option_id
    option_id=$(echo "$project_data" | jq -r --arg status "$target_status" \
        '.data.organization.projectV2.field.options[] | select(.name == $status) | .id')

    if [[ -z "$project_id" || -z "$field_id" || -z "$option_id" ]]; then
        echo -e "${YELLOW}⚠ 无法解析 project 字段信息，跳过状态更新${NC}" >&2
        return 1
    fi

    gh api graphql -f query='
    mutation($projectId: ID!, $itemId: ID!, $fieldId: ID!, $optionId: String!) {
      updateProjectV2ItemFieldValue(input: {
        projectId: $projectId
        itemId: $itemId
        fieldId: $fieldId
        value: { singleSelectOptionId: $optionId }
      }) {
        projectV2Item { id }
      }
    }' -f projectId="$project_id" -f itemId="$item_id" -f fieldId="$field_id" -f optionId="$option_id" \
        >/dev/null 2>&1

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}✓ Issue #${issue_number} 状态已更新为: ${target_status}${NC}"
    else
        echo -e "${YELLOW}⚠ 状态更新失败${NC}" >&2
        return 1
    fi
}

# ─── Issue 轮询 ──────────────────────────────────────────────

issue_poll() {
    local repo
    repo=$(detect_repo) || return 1

    echo -e "${BLUE}=== 扫描可认领的 Issue ===${NC}"
    echo -e "${DIM}仓库: ${repo}  标签: ${ISSUE_LABEL}${NC}"
    echo ""

    local issues
    issues=$(gh issue list --repo "$repo" --label "${ISSUE_LABEL}" --state open \
        --json number,title,labels,assignees,body 2>&1)

    if [[ $? -ne 0 ]]; then
        echo -e "${RED}错误: 无法获取 issues${NC}"
        echo "$issues"
        return 1
    fi

    local count
    count=$(echo "$issues" | jq 'length')

    if [[ "$count" -eq 0 ]]; then
        echo "没有找到带 '${ISSUE_LABEL}' 标签的 open issue。"
        return 0
    fi

    echo -e "${GREEN}找到 ${count} 个候选 issue:${NC}"
    echo ""

    echo "$issues" | jq -r '.[] | "  #\(.number) \(.title)\n    labels: \([.labels[].name] | join(", "))\n    assignees: \(if .assignees | length > 0 then [.assignees[].login] | join(", ") else "none" end)\n"'
}

# ─── Issue 认领 ──────────────────────────────────────────────

issue_claim() {
    local issue_number="${1:-}"
    if [[ -z "$issue_number" ]]; then
        echo -e "${RED}错误: 请提供 issue 编号${NC}"
        echo "用法: sparring issue-claim <number>"
        return 1
    fi

    local backend
    backend=$(get_review_backend) || return 1
    local reviewer
    reviewer=$(reviewer_name_for_backend "$backend")
    local reviewer_label
    reviewer_label=$(reviewer_label_for_backend "$backend")

    local repo
    repo=$(detect_repo) || return 1

    echo -e "${BLUE}=== 认领 Issue #${issue_number} ===${NC}"

    # 检查 issue 是否存在且有 claude-ok label
    local issue_data
    issue_data=$(gh issue view "$issue_number" --repo "$repo" \
        --json number,title,labels,assignees,body,state 2>&1)

    if [[ $? -ne 0 ]]; then
        echo -e "${RED}错误: 无法获取 issue #${issue_number}${NC}"
        echo "$issue_data"
        return 1
    fi

    local title
    title=$(echo "$issue_data" | jq -r '.title')
    local has_label
    has_label=$(echo "$issue_data" | jq -r --arg label "${ISSUE_LABEL}" \
        '[.labels[].name] | any(. == $label)')

    if [[ "$has_label" != "true" ]]; then
        echo -e "${YELLOW}⚠ Issue #${issue_number} 没有 '${ISSUE_LABEL}' 标签${NC}"
        echo "继续认领？(y/n)"
        read -rp "> " confirm
        [[ "$confirm" != "y" ]] && return 0
    fi

    # 更新 project board 状态为 In progress
    echo -e "${DIM}更新看板状态...${NC}"
    update_project_status "$issue_number" "In progress"

    # 检测模式
    local is_yolo
    is_yolo=$(echo "$issue_data" | jq -r '[.labels[].name] | any(. == "yolo")')
    local mode="normal"
    [[ "$is_yolo" == "true" ]] && mode="yolo"

    # 发布认领 comment
    local claim_body="🤖 **Claude Code 已认领此任务**

- 模式: $([ "$mode" = "yolo" ] && echo "🚀 YOLO (全自动)" || echo "👥 Normal (协作式)")
- 审查后端: ${reviewer_label}
- 开始时间: $(date '+%Y-%m-%d %H:%M')

正在分析 issue 内容..."

    local comment_url
    comment_url=$(gh issue comment "$issue_number" --repo "$repo" --body "$claim_body" 2>&1)

    if [[ $? -eq 0 ]]; then
        echo -e "${GREEN}✓ 已认领 Issue #${issue_number}: ${title}${NC}"
        echo -e "${YELLOW}模式: ${mode}${NC}"
    else
        echo -e "${RED}认领 comment 发布失败${NC}"
        echo "$comment_url"
        return 1
    fi

    # 创建本地 workflow 任务
    if [[ ! -d "${PLANS_DIR}" ]]; then
        init_workflow
    fi

    local task_name
    task_name=$(echo "$title" | sed 's/[^a-zA-Z0-9]/-/g' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//' | cut -c1-50)
    local task_id
    task_id="$(date +%Y%m%d-%H%M%S)-issue-${issue_number}"
    local task_dir="${PLANS_DIR}/${task_id}"

    mkdir -p "${task_dir}"

    local body
    body=$(echo "$issue_data" | jq -r '.body')

    jq -n \
        --arg id "$task_id" \
        --arg name "$task_name" \
        --arg ts "$(date -Iseconds)" \
        --arg mode "$mode" \
        --arg reviewer "$reviewer" \
        --argjson issue_number "$issue_number" \
        --arg repo "$repo" \
        '{
            task_id: $id,
            task_name: $name,
            executor: "claude",
            reviewer: $reviewer,
            mode: $mode,
            status: "proposal",
            issue_number: $issue_number,
            repo: $repo,
            created_at: $ts,
            steps: {
                proposal: "pending",
                proposal_review: "pending",
                implementation: "pending",
                code_review: "pending",
                approved: "pending"
            }
        }' > "${task_dir}/meta.json"

    # 保存 issue 内容为 task.md
    cat > "${task_dir}/task.md" <<EOF
# Issue #${issue_number}: ${title}

${body}

---
**执行者**: claude
**观察者**: ${reviewer_label}
**模式**: ${mode}
**Issue**: https://github.com/${repo}/issues/${issue_number}
EOF

    echo ""
    echo -e "${GREEN}本地任务已创建: ${task_id}${NC}"
    echo -e "${BLUE}任务目录: ${task_dir}${NC}"
    echo ""
    echo "下一步:"
    if [[ "$mode" == "yolo" ]]; then
        echo "  YOLO 模式 — 直接开始方案和实现"
    else
        echo "  Normal 模式 — 在 issue comment 中与用户讨论方案"
        echo "  sparring issue-comment ${issue_number} \"你的 comment 内容\""
        echo "  sparring issue-read ${issue_number}  # 读取最新 comments"
    fi
}

# ─── Issue Comment 操作 ──────────────────────────────────────

issue_comment() {
    local issue_number="${1:-}"
    local body="${2:-}"

    if [[ -z "$issue_number" || -z "$body" ]]; then
        echo -e "${RED}错误: 请提供 issue 编号和 comment 内容${NC}"
        echo "用法: sparring issue-comment <number> <body>"
        echo "  或:  sparring issue-comment <number> @file.md  (从文件读取)"
        return 1
    fi

    local repo
    repo=$(detect_repo) || return 1

    # 支持从文件读取 comment 内容
    if [[ "$body" == @* ]]; then
        local file="${body:1}"
        if [[ ! -f "$file" ]]; then
            echo -e "${RED}错误: 文件不存在: ${file}${NC}"
            return 1
        fi
        body=$(cat "$file")
    fi

    local result
    result=$(gh issue comment "$issue_number" --repo "$repo" --body "$body" 2>&1)

    if [[ $? -eq 0 ]]; then
        # 提取 comment URL
        local comment_url
        comment_url=$(echo "$result" | grep -oE 'https://github.com/[^ ]+' | head -1)
        echo -e "${GREEN}✓ Comment 已发布到 Issue #${issue_number}${NC}"
        if [[ -n "$comment_url" ]]; then
            echo -e "${BLUE}${comment_url}${NC}"
        fi
    else
        echo -e "${RED}Comment 发布失败${NC}"
        echo "$result"
        return 1
    fi
}

# ─── 读取 Issue Comments ─────────────────────────────────────

issue_read() {
    local issue_number="${1:-}"
    local count="${2:-5}"

    if [[ -z "$issue_number" ]]; then
        echo -e "${RED}错误: 请提供 issue 编号${NC}"
        echo "用法: sparring issue-read <number> [count]"
        return 1
    fi

    local repo
    repo=$(detect_repo) || return 1

    echo -e "${BLUE}=== Issue #${issue_number} Comments (最近 ${count} 条) ===${NC}"
    echo ""

    local comments
    comments=$(gh issue view "$issue_number" --repo "$repo" --json comments \
        --jq ".comments | .[-${count}:]" 2>&1)

    if [[ $? -ne 0 ]]; then
        echo -e "${RED}错误: 无法读取 comments${NC}"
        echo "$comments"
        return 1
    fi

    local len
    len=$(echo "$comments" | jq 'length')

    if [[ "$len" -eq 0 ]]; then
        echo "暂无 comments。"
        return 0
    fi

    echo "$comments" | jq -r '.[] | "── \(.author.login) (\(.createdAt | split("T")[0])) ──\n\(.body)\n"'
}

# ─── 等待 Issue 回复 ─────────────────────────────────────────

issue_wait_reply() {
    local issue_number="${1:-}"
    local since_comment_count="${2:-}"

    if [[ -z "$issue_number" ]]; then
        echo -e "${RED}错误: 请提供 issue 编号${NC}"
        echo "用法: sparring issue-wait-reply <number> [since_comment_count]"
        return 1
    fi

    local repo
    repo=$(detect_repo) || return 1

    # 记录当前 comment 数量
    if [[ -z "$since_comment_count" ]]; then
        since_comment_count=$(gh issue view "$issue_number" --repo "$repo" \
            --json comments --jq '.comments | length' 2>/dev/null)
    fi

    echo -e "${BLUE}等待 Issue #${issue_number} 的新回复...${NC}"
    echo -e "${DIM}当前 comment 数: ${since_comment_count}，每 ${ISSUE_POLL_INTERVAL}s 检查一次${NC}"
    echo ""

    local elapsed=0
    local max_wait=600  # 10 分钟

    while [[ $elapsed -lt $max_wait ]]; do
        sleep "${ISSUE_POLL_INTERVAL}"
        elapsed=$((elapsed + ISSUE_POLL_INTERVAL))

        local current_count
        current_count=$(gh issue view "$issue_number" --repo "$repo" \
            --json comments --jq '.comments | length' 2>/dev/null)

        if [[ "$current_count" -gt "$since_comment_count" ]]; then
            echo -e "${GREEN}✓ 收到新回复！${NC}"
            echo ""

            # 获取新增的 comments
            local new_count=$((current_count - since_comment_count))
            gh issue view "$issue_number" --repo "$repo" --json comments \
                --jq ".comments | .[-${new_count}:][] | \"── \\(.author.login) ──\\n\\(.body)\\n\""

            return 0
        fi

        echo -e "${DIM}  [${elapsed}s] 暂无新回复...${NC}"
    done

    echo -e "${YELLOW}⚠ 等待 ${max_wait}s 后仍无回复${NC}"
    return 1
}

# ─── Issue 完成 — 更新状态到 Reviewing ────────────────────────

issue_done() {
    local issue_number="${1:-}"
    local pr_url="${2:-}"

    if [[ -z "$issue_number" ]]; then
        echo -e "${RED}错误: 请提供 issue 编号${NC}"
        echo "用法: sparring issue-done <number> [pr_url]"
        return 1
    fi

    local repo
    repo=$(detect_repo) || return 1

    # 更新看板状态
    update_project_status "$issue_number" "Reviewing"

    # 发布完成 comment
    local done_body="🔗 **PR 已创建**: ${pr_url:-"(手动创建)"}

任务已移至 **Reviewing** 状态，请 review。"

    gh issue comment "$issue_number" --repo "$repo" --body "$done_body" >/dev/null 2>&1

    echo -e "${GREEN}✓ Issue #${issue_number} 已移至 Reviewing${NC}"
}

# ─── 列出任务 ────────────────────────────────────────────────

list_tasks() {
    echo -e "${BLUE}=== 所有任务 ===${NC}"
    echo ""

    if [[ ! -d "${PLANS_DIR}" ]] || [[ -z "$(ls -A "${PLANS_DIR}" 2>/dev/null)" ]]; then
        echo "暂无任务"
        return
    fi

    for task_dir in "${PLANS_DIR}"/*; do
        if [[ -f "${task_dir}/meta.json" ]]; then
            local task_id
            task_id=$(basename "$task_dir")
            local task_name status executor
            task_name=$(jq -r '.task_name' "${task_dir}/meta.json")
            status=$(jq -r '.status' "${task_dir}/meta.json")
            executor=$(jq -r '.executor' "${task_dir}/meta.json")

            echo -e "${YELLOW}${task_id}${NC}"
            echo "  名称: ${task_name}  状态: ${status}  执行者: ${executor}"
            echo ""
        fi
    done
}

# ─── 显示状态 ────────────────────────────────────────────────

show_status() {
    local task_id="${1:-}"
    validate_task_exists "$task_id"
    local task_dir="${PLANS_DIR}/${task_id}"

    echo -e "${BLUE}=== 任务状态: ${task_id} ===${NC}"
    echo ""
    jq '.' "${task_dir}/meta.json"
    echo ""
    echo -e "${BLUE}文件列表:${NC}"
    ls -lh "${task_dir}/"
}

# ─── Config 子命令 ──────────────────────────────────────────

# 返回给用户看的配置视图。两个后端都靠各自 CLI 的登录态，
# sparring 自己不存任何 key，所以这里没有需要打掩码的字段。
_config_masked_view() {
    _config_merged
}

config_show() {
    echo -e "${BLUE}=== Sparring 配置（合并后）===${NC}"
    echo ""
    echo -e "${DIM}优先级: env (SPARRING_*/WORKFLOW_*) > project (.sparring/config.json) > global (~/.config/sparring/config.json) > 默认${NC}"
    echo ""
    _config_masked_view
    echo ""
    echo -e "${BLUE}配置文件:${NC}"
    echo "  global:  ${CONFIG_FILE_GLOBAL} $([[ -f "$CONFIG_FILE_GLOBAL" ]] && echo "(存在)" || echo "(未创建)")"
    echo "  project: ${CONFIG_FILE_PROJECT} $([[ -f "$CONFIG_FILE_PROJECT" ]] && echo "(存在)" || echo "(未创建)")"
}

config_path() {
    echo "global:  ${CONFIG_FILE_GLOBAL}"
    echo "project: ${CONFIG_FILE_PROJECT}"
}

config_get_cmd() {
    local path="${1:-}"
    if [[ -z "$path" ]]; then
        echo -e "${RED}错误: 请提供 key 路径${NC}" >&2
        echo "用法: sparring config get <key.path>" >&2
        echo "示例: sparring config get review.backend" >&2
        return 1
    fi
    local val
    val=$(_config_get "$path")
    # 敏感字段打掩码
    case "$path" in
        *api_key|*token|*secret*)
            if [[ -n "$val" && ${#val} -gt 8 ]]; then
                val="${val:0:4}***${val: -4}"
            elif [[ -n "$val" ]]; then
                val="***"
            fi
            ;;
    esac
    echo "$val"
}

config_init() {
    local project_mode=false
    local force=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help|help) _config_cmd_help; return 0 ;;
            -p|--scope-project|project) project_mode=true; shift ;;
            -g|--scope-global|global) project_mode=false; shift ;;
            -f|--force) force=true; shift ;;
            *) echo -e "${RED}未知选项: $1${NC}" >&2; return 1 ;;
        esac
    done

    local target dir
    if $project_mode; then
        target="$CONFIG_FILE_PROJECT"
        dir="$CONFIG_DIR_PROJECT"
    else
        target="$CONFIG_FILE_GLOBAL"
        dir="$CONFIG_DIR_GLOBAL"
    fi

    if [[ -f "$target" ]] && ! $force; then
        echo -e "${YELLOW}配置已存在: ${target}${NC}"
        echo "  加 --force 覆盖，或直接编辑该文件。"
        return 0
    fi

    # 同时兼容两种情况：用 $dir（跟默认布局一致）+ $target 的 dirname（防止用户
    # 只覆盖 CONFIG_FILE_* 不覆盖 CONFIG_DIR_*，导致父目录不存在）
    mkdir -p "$dir" "$(dirname "$target")"

    if $project_mode; then
        # 项目级：只放团队需统一的非主观项（如 timeout/retries），绝不放 backend/model。
        # 用什么 reviewer 后端和模型由各开发者全局配置决定，项目级不约束（写了会覆盖个人选择）。
        cat > "$target" <<'EOF'
{
  "_comment": "项目级 Sparring 配置（团队共享，入库）。只放团队需要统一的非主观项（如 review.timeout / retries）。用什么 reviewer 后端和模型由各开发者的全局配置 (~/.config/sparring/config.json) 决定 —— 项目级不要设 review.backend / fallback / *.model，写了会覆盖每个人的个人选择。",
  "review": {
    "timeout": 1800,
    "retries": 1
  }
}
EOF
        # 安全追加 .gitignore：存在则只补齐缺失规则，不覆盖用户现有规则
        local gi="${dir}/.gitignore"
        local want_rules=("*.local.json" "*.secret.json")
        if [[ -f "$gi" ]]; then
            for rule in "${want_rules[@]}"; do
                if ! grep -Fxq "$rule" "$gi" 2>/dev/null; then
                    printf '%s\n' "$rule" >> "$gi"
                fi
            done
        else
            {
                echo "# Sparring — 屏蔽本地/衍生文件"
                echo "# 项目级 config.json 默认入库用于团队共享"
                printf '%s\n' "${want_rules[@]}"
            } > "$gi"
        fi
        echo -e "${GREEN}✓ 项目级配置已创建: ${target}${NC}"
        echo "  ${dir}/.gitignore 已就绪（屏蔽 *.local.json / *.secret.json）"
        echo -e "${YELLOW}  ⚠ 不要在 ${target} 里设 backend / 模型 — 这些由各开发者全局配置决定${NC}"
        echo "  全局配置（backend / 模型）: sparring config init"
    else
        # 全局：backend 选择 + 模型。两个后端都靠各自 CLI 的登录态，这里不存任何 key。
        cat > "$target" <<'EOF'
{
  "_comment": "全局 Sparring 配置。backend / fallback 只能是 claude 或 opencode，两者都用各自 CLI 已登录的账号，sparring 不存 API key。model 留 null = 用该 CLI 自己的默认模型。",
  "review": {
    "backend": "claude",
    "fallback": "opencode",
    "timeout": 1800,
    "retries": 1,
    "log_retention_days": 7
  },
  "claude": {
    "model": null
  },
  "opencode": {
    "model": null
  }
}
EOF
        chmod 600 "$target"
        echo -e "${GREEN}✓ 全局配置已创建: ${target}${NC} (chmod 600)"
        echo "  默认 backend=claude、fallback=opencode，两个 CLI 都要先各自登录。"
        echo "  检查连通性: sparring verify"
    fi
}

_config_cmd_help() {
    cat <<HELPEOF
sparring config — 配置管理

用法: sparring config <子命令> [参数]

子命令:
  show              打印合并后的生效配置
  path              打印 global / project 配置文件路径
  get <key.path>    取单个配置值
                    例: sparring config get review.backend
                        sparring config get claude.model
  init              生成全局配置 ~/.config/sparring/config.json (chmod 600)
  init project      生成项目配置 ./.sparring/config.json (团队共享)
  init --force      已存在时强制覆盖（只作用于 config.json，不动 .gitignore）

示例:
  sparring config init
  sparring config init project
  sparring config show
  sparring config get claude.model
HELPEOF
}

config_cmd() {
    local sub="${1:-show}"
    shift 2>/dev/null || true

    # 全局 --help / -h
    case "$sub" in
        -h|--help|help) _config_cmd_help; return 0 ;;
    esac

    case "$sub" in
        show)   config_show "$@" ;;
        path)   config_path "$@" ;;
        get)    config_get_cmd "$@" ;;
        init)   config_init "$@" ;;
        *)
            echo -e "${RED}未知子命令: ${sub}${NC}" >&2
            echo "" >&2
            _config_cmd_help >&2
            return 1
            ;;
    esac
}

# ─── 验证环境 ────────────────────────────────────────────────

# 后端连通性自检：两个后端都是 agent CLI，跑法一样，只有命令和版本探测不同。
# 探测故意不给任何工具活干（就让它回一个 OK），避免自检本身跑成一次真实 review。
_verify_agent_backend() {
    local backend="$1"
    local label
    label=$(reviewer_label_for_backend "$backend")

    echo -n "${backend} CLI: "
    if ! command -v "$backend" &>/dev/null; then
        echo -e "${RED}✗ 未安装${NC}"
        case "$backend" in
            claude)   echo -e "${DIM}  npm install -g @anthropic-ai/claude-code${NC}" ;;
            opencode) echo -e "${DIM}  安装说明: https://opencode.ai/docs${NC}" ;;
        esac
        return 1
    fi
    echo -e "${GREEN}✓ $(command "$backend" --version 2>/dev/null | head -1)${NC}"

    local model use_proxy
    model=$(_config_get "${backend}.model")
    use_proxy=$(_config_get "${backend}.use_proxy")
    echo -e "  模型: ${model:-default(CLI 自己的默认)}"
    echo -e "  代理: $([[ "$use_proxy" == "true" ]] && echo "保留" || echo "已清空")"

    # 原生 claude 会加载 ~/.claude/CLAUDE.md 进 reviewer 上下文
    if [[ "$backend" == "claude" && -f "$HOME/.claude/CLAUDE.md" ]]; then
        echo -e "${DIM}  注: ~/.claude/CLAUDE.md 会被加载进 reviewer 上下文${NC}"
    fi

    echo -n "  连通性: "
    AGENT_CMD=()
    case "$backend" in
        claude)   _agent_cmd_claude "$model" ;;
        opencode) _agent_cmd_opencode "$model" ;;
    esac

    local out err_file run_cwd
    err_file=$(mktemp "${TMPDIR:-/tmp}/sparring-verify-log.XXXXXX")
    run_cwd=$(mktemp -d "${TMPDIR:-/tmp}/sparring-verify-cwd.XXXXXX")
    local _vclean="rm -f \"$err_file\"; rm -rf \"$run_cwd\""

    local -a envs=()
    [[ "$use_proxy" != "true" ]] && envs+=("HTTP_PROXY=" "HTTPS_PROXY=")

    if out=$( cd "$run_cwd" && _timeout_cmd 90 env ${envs[@]+"${envs[@]}"} "${AGENT_CMD[@]}" \
                <<< "Reply with only: OK" 2>"$err_file" ); then
        out=$(printf '%s' "$out" | _strip_agent_noise)
        if echo "$out" | grep -qi "OK"; then
            echo -e "${GREEN}✓ 正常${NC}"
        else
            echo -e "${YELLOW}? 有响应但内容异常: ${out:0:80}${NC}"
        fi
        eval "$_vclean"
        return 0
    fi

    local err_summary hint
    err_summary=$(grep -vE '^$' "$err_file" 2>/dev/null | head -1 | cut -c1-120)
    if echo "$err_summary" | grep -qi 'unauthor\|401\|invalid.*key\|authentication\|not logged in'; then
        hint="先登录该 CLI（claude: claude login；opencode: opencode auth login）"
    elif echo "$err_summary" | grep -qi 'not found\|command not found\|enoent'; then
        hint="CLI 没装好，按上面的安装说明重装"
    elif echo "$err_summary" | grep -qi 'timeout\|timed out'; then
        hint="调大 SPARRING_REVIEW_TIMEOUT 或检查网络/代理"
    else
        hint="确认该 CLI 能在终端里直接跑通，再确认 ${backend}.model 配置正确"
    fi
    eval "$_vclean"
    echo -e "${RED}✗ 连接失败${NC}"
    [[ -n "$err_summary" ]] && echo -e "${DIM}  错误: ${err_summary}${NC}"
    echo -e "${YELLOW}  提示: ${hint}${NC}"
    echo -e "${DIM}  (标签: ${label})${NC}"
    return 1
}

_verify_backend() {
    local role="$1"
    local backend="$2"
    local label
    label=$(reviewer_label_for_backend "$backend")
    echo ""
    echo -e "${BLUE}── ${role}: ${label} (${backend}) ──${NC}"
    _verify_agent_backend "$backend"
}

verify() {
    echo -e "${BLUE}=== 环境验证 ===${NC}"
    echo ""

    local ok=true
    local primary fallback
    primary=$(get_review_backend) || return 1
    fallback=$(get_review_backend_fallback) || return 1

    echo -n "jq: "
    if command -v jq &>/dev/null; then
        echo -e "${GREEN}✓ $(jq --version)${NC}"
    else
        echo -e "${RED}✗ 未安装${NC}"
        ok=false
    fi

    echo -n "git: "
    if command -v git &>/dev/null; then
        echo -e "${GREEN}✓ $(git --version | awk '{print $3}')${NC}"
    else
        echo -e "${RED}✗ 未安装（--range 快照审查依赖 git worktree）${NC}"
        ok=false
    fi

    echo -n "超时: "
    local _verify_base _verify_attempts
    _verify_base=$(_agent_timeout)
    _verify_attempts=$(_agent_attempts)
    echo -e "${GREEN}${_verify_base}s${NC}/次  重试次数: $(_config_get review.retries) (共 ${_verify_attempts} 次尝试，最坏总等待 ≈ $(( _verify_base * _verify_attempts ))s)"

    _verify_backend "主 backend" "$primary" || ok=false

    if [[ -n "$fallback" ]]; then
        if [[ "$fallback" == "$primary" ]]; then
            echo ""
            echo -e "${YELLOW}⚠ 备 backend 与主相同 (${primary})，跳过${NC}"
        else
            _verify_backend "备 backend" "$fallback" || echo -e "${DIM}  (备 backend 失败不阻塞主流程)${NC}"
        fi
    else
        echo ""
        echo -e "${DIM}备 backend: 未配置（设置 review.fallback / SPARRING_REVIEW_FALLBACK 启用降级）${NC}"
    fi

    echo ""
    echo -n "项目根目录: "
    echo -e "${GREEN}${PROJECT_ROOT}${NC}"

    echo -n ".workflow 目录: "
    if [[ -d "${WORKFLOW_DIR}" ]]; then
        echo -e "${GREEN}✓ 已初始化${NC}"
    else
        echo -e "${YELLOW}未初始化 (运行 sparring init)${NC}"
    fi

    echo ""
    if $ok; then
        echo -e "${GREEN}✓ 环境就绪${NC}"
        return 0
    else
        echo -e "${RED}✗ 存在问题，请修复后重试${NC}"
        return 1
    fi
}

# ─── 主函数 ──────────────────────────────────────────────────

_validate_backend_env() {
    # 早期校验 env 传入的 backend 值（空值跳过 — 让 get_review_backend 走默认）
    local val
    for var in SPARRING_REVIEW_BACKEND WORKFLOW_REVIEW_BACKEND \
               SPARRING_REVIEW_FALLBACK WORKFLOW_REVIEW_BACKEND_FALLBACK; do
        val="${!var:-}"
        [[ -z "$val" ]] && continue
        if ! _normalize_backend "$val" >/dev/null 2>&1; then
            echo -e "${RED}错误: ${var}='${val}' 不是合法 backend（仅支持 ${REVIEW_BACKENDS}）${NC}" >&2
            exit 1
        fi
    done

    for var in SPARRING_REVIEW_LEVEL WORKFLOW_REVIEW_LEVEL; do
        val="${!var:-}"
        [[ -z "$val" ]] && continue
        if ! _normalize_level "$val" >/dev/null 2>&1; then
            echo -e "${RED}错误: ${var}='${val}' 不是合法 level（仅支持 ${REVIEW_LEVELS}）${NC}" >&2
            exit 1
        fi
    done
}

main() {
    check_deps
    _validate_backend_env

    # 提取 --project <url> 参数
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project)
                shift
                if [[ $# -eq 0 ]]; then
                    echo -e "${RED}错误: --project 需要一个 URL 参数${NC}" >&2
                    exit 1
                fi
                set_project "$1" || exit 1
                shift
                ;;
            *) args+=("$1"); shift ;;
        esac
    done
    # bash 3.2 + set -u: 空数组展开会报 unbound variable。用 +"${...}" 语法防空
    set -- ${args[@]+"${args[@]}"}

    local command="${1:-help}"
    shift 2>/dev/null || true

    case "$command" in
        setup)               exec bash "$(_resolve_script_dir)/bin/setup" "$@" ;;
        init)                init_workflow ;;
        create)              create_task "$@" ;;
        propose)             propose "$@" ;;
        review)              review_adhoc "$@" ;;
        review-proposal)     review_proposal "$@" ;;
        review-proposal-bg)  review_proposal_bg "$@" ;;
        auto-review-proposal) auto_review_proposal "$@" ;;
        approve-proposal)    approve_proposal "$@" ;;
        implement)           implement "$@" ;;
        review-code)         review_code "$@" ;;
        review-code-bg)      review_code_bg "$@" ;;
        auto-review-code)    auto_review_code "$@" ;;
        approve)             approve_final "$@" ;;
        review-status)       show_review_status "$@" ;;
        review-result)       show_review_result "$@" ;;
        review-cancel)       cancel_review_job "$@" ;;
        __review-worker)     run_review_worker "$@" ;;
        list)                list_tasks ;;
        status)              show_status "$@" ;;
        verify)              verify ;;
        config)              config_cmd "$@" ;;
        issue-poll)          issue_poll "$@" ;;
        issue-claim)         issue_claim "$@" ;;
        issue-comment)       issue_comment "$@" ;;
        issue-read)          issue_read "$@" ;;
        issue-wait-reply)    issue_wait_reply "$@" ;;
        issue-done)          issue_done "$@" ;;
        issue-status)        update_project_status "$@" ;;
        help|--help|-h)
            cat <<EOF
${BLUE}Sparring${NC} — AI 左右脑互搏

${YELLOW}用法:${NC} sparring <command> [options]
${DIM}(兼容别名: workflow，历史脚本仍可用)${NC}

${YELLOW}初始化:${NC}
  ${GREEN}setup${NC}                         交互式初始化 (选择模型、配置 Issue 模式)
  ${GREEN}verify${NC}                        验证环境 (依赖、review backend 连通性)

${YELLOW}快速审查 (不建 task):${NC}
  ${GREEN}review --range${NC} <git-range>   审当前仓库的一段改动（推荐）。建只读 worktree 快照，
                                reviewer 在快照里自己跑 git diff / 读文件，审完删快照。
                                例: sparring review --range origin/main...HEAD
  ${GREEN}review${NC} [--title <主题>] [<内容>]  审一段结论/方案文本（参数或 stdin 传入，不建快照）
                                退出码 0=APPROVE 2=CONCERNS 1=错误
                                ⚠ 不再接收 diff 文本，管道进 diff 会直接报错 — 改用 --range

${YELLOW}任务管理:${NC}
  ${GREEN}init${NC}                          初始化工作流目录
  ${GREEN}create${NC} <name> <claude|cursor>  创建新任务
  ${GREEN}list${NC}                          列出所有任务
  ${GREEN}status${NC} <task-id>              查看任务状态

${YELLOW}方案阶段:${NC}
  ${GREEN}propose${NC} <task-id>             执行者编写方案
  ${GREEN}review-proposal${NC} <task-id>     自动调用 reviewer backend review 方案
  ${GREEN}review-proposal-bg${NC} <task-id>  后台运行方案 review（返回 job-id）
  ${GREEN}auto-review-proposal${NC} <task-id> 自动 review 循环 (Skill 模式下最多 ${MAX_REVIEW_ROUNDS} 轮，CLI 下单轮)
  ${GREEN}approve-proposal${NC} <task-id>    批准方案

${YELLOW}实现阶段:${NC}
  ${GREEN}implement${NC} <task-id>           执行者实现代码
  ${GREEN}review-code${NC} <task-id>         自动调用 reviewer backend review 代码
  ${GREEN}review-code-bg${NC} <task-id>      后台运行代码 review（返回 job-id）
  ${GREEN}auto-review-code${NC} <task-id>    自动 review 循环 (Skill 模式下最多 ${MAX_REVIEW_ROUNDS} 轮，CLI 下单轮)
  ${GREEN}approve${NC} <task-id>             最终批准

${YELLOW}后台 Review 作业:${NC}
  ${GREEN}review-status${NC} [job-id|task-id] 查看后台 review 作业状态
  ${GREEN}review-result${NC} <job-id>        查看后台 review 的最终结果
  ${GREEN}review-cancel${NC} <job-id>        取消后台 review 作业

${YELLOW}GitHub Issue 集成:${NC}
  ${GREEN}issue-poll${NC}                    扫描带 ${ISSUE_LABEL} 标签的可认领 issue
  ${GREEN}issue-claim${NC} <number>          认领 issue (更新看板状态 + 发布 comment)
  ${GREEN}issue-comment${NC} <number> <body> 在 issue 上发布 comment (支持 @file.md)
  ${GREEN}issue-read${NC} <number> [count]   读取 issue 最近的 comments (默认 5 条)
  ${GREEN}issue-wait-reply${NC} <number>     轮询等待 issue 新回复 (每 ${ISSUE_POLL_INTERVAL}s，最多 10min)
  ${GREEN}issue-done${NC} <number> [pr_url]  标记完成 (状态 → Reviewing + 发布 comment)
  ${GREEN}issue-status${NC} <number> <status> 更新 issue 看板状态

${YELLOW}配置:${NC}
  ${GREEN}config init${NC}                 生成 ~/.config/sparring/config.json
  ${GREEN}config init project${NC}         生成 .sparring/config.json（项目级，团队共享）
  ${GREEN}config show${NC}                 显示合并后的生效配置
  ${GREEN}config path${NC}                 打印 global / project 配置文件路径
  ${GREEN}config get <key.path>${NC}       取单个值，如 config get review.backend

${YELLOW}全局选项:${NC}
  ${GREEN}--project${NC} <url>               指定 GitHub Project 看板 URL

${YELLOW}配置文件（优先级从低到高）:${NC}
  内置默认 → global (${CONFIG_FILE_GLOBAL})
          → project (.sparring/config.json)
          → env 变量 (SPARRING_*, WORKFLOW_* 兼容)

${YELLOW}环境变量（可覆盖 config.json 任意字段）:${NC}
  主推 SPARRING_* 前缀，SPARRING_<KEY_PATH> 对应 config 的 key.path（全大写、点转下划线）
  兼容 WORKFLOW_* 前缀（历史变量）

  ${DIM}示例:${NC}
    SPARRING_REVIEW_BACKEND=opencode  对应 review.backend（合法值: ${REVIEW_BACKENDS}）
    SPARRING_REVIEW_FALLBACK=claude   对应 review.fallback
    SPARRING_REVIEW_TIMEOUT=900       对应 review.timeout（单次调用秒数）
    SPARRING_CLAUDE_MODEL=...         对应 claude.model（留空 = CLI 自己的默认模型）
    SPARRING_OPENCODE_MODEL=...       对应 opencode.model

  ${DIM}历史兼容（仍生效）:${NC}
    WORKFLOW_REVIEW_BACKEND_FALLBACK → review.fallback
    以及所有 WORKFLOW_* 形式的新 schema 变量

  ${DIM}超时: reviewer 是自己跑 git/读文件的 agent，耗时以分钟计，默认单次 600s。${NC}
  ${DIM}⚠ 最坏总等待 ≈ review.timeout × (retries+1)。想快速失败可设 review.retries=0。${NC}

${YELLOW}Issue 相关环境变量:${NC}
  WORKFLOW_POLL_INTERVAL  issue 轮询间隔秒数 (默认: ${ISSUE_POLL_INTERVAL})
  WORKFLOW_ISSUE_LABEL    issue 筛选标签 (默认: ${ISSUE_LABEL})
  WORKFLOW_PROJECT_NUMBER project 编号 (环境变量或 --project)
  WORKFLOW_PROJECT_OWNER  project 所属组织 (环境变量或 --project)

${YELLOW}示例:${NC}
  sparring setup                             # 交互式初始化
  sparring verify                           # 检查环境
  sparring review --range origin/main...HEAD # 审当前分支的改动
  sparring create "refactor-auth" claude     # 创建任务
  sparring review-proposal <task-id>        # 自动 review
  sparring --project https://github.com/orgs/kanyun-inc/projects/3 issue-poll
  sparring issue-claim 106                  # 认领 issue #106
  sparring issue-comment 106 "方案 LGTM"   # 发布 comment

EOF
            ;;
        *)
            echo -e "${RED}未知命令: $command${NC}"
            echo "运行 'sparring help' 查看帮助"
            exit 1
            ;;
    esac
}

main "$@"
