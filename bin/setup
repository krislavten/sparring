#!/bin/bash

# Sparring — 交互式初始化设置
# 帮助用户快速配置环境

set -euo pipefail

# --help/-h 快速路径：不进入交互流程
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'USAGE'
Sparring setup — 交互式安装

用法: sparring setup

功能:
  1. 检查 & 安装依赖（jq、git、gh、reviewer 后端 CLI）
  2. 选择 reviewer 后端（claude / opencode）并写全局配置
  3. 可选：配置 Issue 驱动模式
  4. 安装 CLI 软链（sparring + workflow 兼容别名）+ Claude Code skill
  5. 运行 sparring verify

必须在交互式终端里跑（stdin 是 TTY）。
USAGE
    exit 0
fi

# 必须是交互式 TTY — 防止 CI/测试/子进程误触发完整 setup 流程
if [[ ! -t 0 ]]; then
    echo "错误: setup 必须在交互式终端里运行（stdin 不是 TTY）" >&2
    echo "提示: 用 sparring setup --help 查看功能说明" >&2
    exit 2
fi

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# ─── 工具函数 ────────────────────────────────────────────────

print_header() {
    echo ""
    echo -e "${BOLD}${BLUE}═══════════════════════════════════════════${NC}"
    echo -e "${BOLD}${BLUE}  Dual AI Workflow Setup${NC}"
    echo -e "${BOLD}${BLUE}═══════════════════════════════════════════${NC}"
    echo ""
}

print_step() {
    local step="$1"
    local total="$2"
    local desc="$3"
    echo ""
    echo -e "${BOLD}[${step}/${total}] ${desc}${NC}"
    echo -e "${DIM}───────────────────────────────────────────${NC}"
}

prompt_choice() {
    local prompt="$1"
    local default="$2"
    local result

    if [[ -n "$default" ]]; then
        read -rp "$(echo -e "${YELLOW}${prompt} [${default}]: ${NC}")" result
        echo "${result:-$default}"
    else
        read -rp "$(echo -e "${YELLOW}${prompt}: ${NC}")" result
        echo "$result"
    fi
}

prompt_yn() {
    local prompt="$1"
    local default="${2:-y}"
    local result

    if [[ "$default" == "y" ]]; then
        read -rp "$(echo -e "${YELLOW}${prompt} [Y/n]: ${NC}")" result
        [[ -z "$result" || "$result" =~ ^[Yy] ]]
    else
        read -rp "$(echo -e "${YELLOW}${prompt} [y/N]: ${NC}")" result
        [[ "$result" =~ ^[Yy] ]]
    fi
}

# ─── Step 1: 检测并安装依赖 ──────────────────────────────────

ensure_brew() {
    if command -v brew &>/dev/null; then
        return 0
    fi

    echo -e "  ${YELLOW}Homebrew 未安装，正在安装...${NC}"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

    # Apple Silicon 路径
    if [[ -f /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi

    if ! command -v brew &>/dev/null; then
        echo -e "${RED}Homebrew 安装失败，请手动安装后重试${NC}"
        exit 1
    fi
    echo -e "  ${GREEN}Homebrew 安装成功${NC}"
}

brew_install() {
    local name="$1"
    local formula="${2:-$name}"
    echo -e "  ${YELLOW}正在安装 ${name}...${NC}"
    brew install "$formula"
    if command -v "$name" &>/dev/null; then
        echo -e "  ${GREEN}${name} 安装成功${NC}"
    else
        echo -e "${RED}${name} 安装失败${NC}"
        return 1
    fi
}

check_dependencies() {
    print_step 1 5 "检测并安装依赖"

    local need_brew=false

    # 检查哪些需要装
    echo -n "  jq: "
    if command -v jq &>/dev/null; then
        echo -e "${GREEN}$(jq --version)${NC}"
    else
        echo -e "${YELLOW}未安装${NC}"
        need_brew=true
    fi

    echo -n "  git: "
    if command -v git &>/dev/null; then
        echo -e "${GREEN}$(git --version | awk '{print $3}')${NC}"
    else
        echo -e "${YELLOW}未安装${NC}"
        need_brew=true
    fi

    echo -n "  gh (GitHub CLI): "
    if command -v gh &>/dev/null; then
        echo -e "${GREEN}$(gh --version | head -1)${NC}"
    else
        echo -e "${YELLOW}未安装${NC}"
        need_brew=true
    fi

    # reviewer 后端：两个都是 agent CLI，装哪个都能跑，装两个才有降级
    echo -n "  claude (Claude Code CLI): "
    if command -v claude &>/dev/null; then
        echo -e "${GREEN}$(command claude --version 2>/dev/null | head -1)${NC}"
    else
        echo -e "${YELLOW}未安装 — npm install -g @anthropic-ai/claude-code${NC}"
    fi

    echo -n "  opencode: "
    if command -v opencode &>/dev/null; then
        echo -e "${GREEN}$(command opencode --version 2>/dev/null | head -1)${NC}"
    else
        echo -e "${YELLOW}未安装 — 见 https://opencode.ai/docs${NC}"
    fi

    # 安装缺失的 brew 依赖
    if [[ "$need_brew" == true ]]; then
        echo ""
        ensure_brew

        if ! command -v jq &>/dev/null; then
            brew_install jq
        fi

        if ! command -v git &>/dev/null; then
            brew_install git
        fi

        if ! command -v gh &>/dev/null; then
            brew_install gh
            echo ""
            echo -e "  ${YELLOW}gh 需要登录 GitHub:${NC}"
            echo -e "    ${DIM}gh auth login${NC}"
            if prompt_yn "  现在登录？" "y"; then
                gh auth login || true
            fi
        fi
    fi

    # 最终检查必要依赖：jq/git 必须有，reviewer 后端至少有一个
    echo ""
    local ok=true
    echo -n "  最终检查 — jq: "
    if command -v jq &>/dev/null; then echo -e "${GREEN}OK${NC}"; else echo -e "${RED}缺失${NC}"; ok=false; fi
    echo -n "  最终检查 — git: "
    if command -v git &>/dev/null; then echo -e "${GREEN}OK${NC}"; else echo -e "${RED}缺失${NC}"; ok=false; fi
    echo -n "  最终检查 — reviewer 后端: "
    if command -v claude &>/dev/null || command -v opencode &>/dev/null; then
        echo -e "${GREEN}OK${NC}"
    else
        echo -e "${RED}缺失（claude / opencode 至少装一个）${NC}"
        ok=false
    fi

    if [[ "$ok" == false ]]; then
        echo ""
        echo -e "${RED}核心依赖缺失，无法继续。${NC}"
        exit 1
    fi
}

# ─── Step 2: 选择 reviewer 后端 ──────────────────────────────

select_backend() {
    print_step 2 5 "选择 reviewer 后端"

    echo -e "  reviewer 是个 agent：给它一段 range，它自己去仓库里跑 git diff、读文件。"
    echo -e "  两个后端都用各自 CLI 已登录的账号，sparring 不存 API key。"
    echo ""
    echo -e "    1) ${BOLD}claude${NC}     — Claude Code CLI ${GREEN}(推荐)${NC}"
    echo -e "    2) opencode   — opencode run --agent plan"
    echo ""

    local choice
    choice=$(prompt_choice "选择主后端" "1")
    case "$choice" in
        2) SELECTED_BACKEND="opencode"; SELECTED_FALLBACK="claude" ;;
        *) SELECTED_BACKEND="claude";   SELECTED_FALLBACK="opencode" ;;
    esac

    echo ""
    echo -e "  主后端调用失败时会自动降级到另一个。"
    if ! prompt_yn "  启用降级到 ${SELECTED_FALLBACK}？" "y"; then
        SELECTED_FALLBACK=""
    fi

    echo ""
    echo -e "  ${GREEN}主后端: ${SELECTED_BACKEND}${NC}  降级: ${SELECTED_FALLBACK:-（关闭）}"
}

# ─── Step 3: Issue 驱动配置 ──────────────────────────────────

configure_issue_mode() {
    print_step 3 5 "配置 Issue 驱动模式（可选）"

    echo -e "  Issue 驱动模式让 Claude 从 GitHub Issue 获取任务，"
    echo -e "  讨论和进度自动同步到 Issue comment。"
    echo ""

    if ! prompt_yn "是否配置 Issue 驱动模式？" "n"; then
        ISSUE_CONFIGURED=false
        echo -e "  ${DIM}跳过。可以之后通过环境变量配置。${NC}"
        return
    fi

    ISSUE_CONFIGURED=true
    echo ""

    # 检测当前 repo
    local detected_owner=""
    local detected_repo=""
    if git remote get-url origin &>/dev/null; then
        local remote_url
        remote_url=$(git remote get-url origin 2>/dev/null)
        detected_owner=$(echo "$remote_url" | sed -E 's|.*github\.com[:/]([^/]+)/.*|\1|')
        detected_repo=$(echo "$remote_url" | sed -E 's|.*github\.com[:/]([^/]+/[^/.]+)(\.git)?$|\1|')
        echo -e "  ${DIM}检测到仓库: ${detected_repo}${NC}"
    fi

    ISSUE_PROJECT_OWNER=$(prompt_choice "GitHub 组织/用户名" "${detected_owner}")
    ISSUE_PROJECT_NUMBER=$(prompt_choice "GitHub Project 编号" "")
    ISSUE_LABEL=$(prompt_choice "Issue 筛选标签" "claude-ok")

    echo ""
    echo -e "  ${GREEN}Issue 配置:${NC}"
    echo -e "    组织: ${ISSUE_PROJECT_OWNER}"
    echo -e "    Project: #${ISSUE_PROJECT_NUMBER}"
    echo -e "    标签: ${ISSUE_LABEL}"
}

# ─── Step 4: 生成配置 + 安装 ─────────────────────────────────

install_and_configure() {
    print_step 4 5 "安装和生成配置"

    # 运行 install.sh 的核心逻辑（不重复执行如果已安装）
    # 1. sparring 命令（workflow 为兼容别名）
    local target_dir=""
    if [[ -d "$HOME/.local/bin" ]]; then
        target_dir="$HOME/.local/bin"
    elif [[ -d "/usr/local/bin" ]]; then
        target_dir="/usr/local/bin"
    fi

    if [[ -n "$target_dir" ]]; then
        local sudo_cmd=""
        [[ "$target_dir" == /usr/local/bin ]] && sudo_cmd="sudo"
        $sudo_cmd ln -sf "${PROJECT_DIR}/bin/sparring" "${target_dir}/sparring"
        $sudo_cmd ln -sf "${PROJECT_DIR}/bin/sparring" "${target_dir}/workflow"
        echo -e "  ${GREEN}已安装 sparring 到 ${target_dir}/ (workflow 为兼容别名)${NC}"
    else
        echo -e "  ${YELLOW}请手动添加到 PATH: export PATH=\"${PROJECT_DIR}/bin:\$PATH\"${NC}"
    fi

    # 2. Claude Code skill
    local skills_dir="$HOME/.claude/skills"
    mkdir -p "${skills_dir}"
    ln -sf "${PROJECT_DIR}/.skills/workflow" "${skills_dir}/sparring"
    echo -e "  ${GREEN}已安装 sparring skill${NC}"

    # 3. 写全局配置（后端选择）。已有配置只改 backend/fallback，不动用户其他字段。
    local cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/sparring"
    local cfg_file="${cfg_dir}/config.json"
    mkdir -p "$cfg_dir"
    local existing='{}'
    [[ -f "$cfg_file" ]] && jq -e '.' "$cfg_file" >/dev/null 2>&1 && existing=$(cat "$cfg_file")
    jq -n --argjson cur "$existing" \
        --arg backend "$SELECTED_BACKEND" \
        --arg fallback "$SELECTED_FALLBACK" \
        '$cur * {review: {backend: $backend,
                          fallback: (if $fallback == "" then null else $fallback end)}}' \
        > "$cfg_file"
    chmod 600 "$cfg_file"
    echo -e "  ${GREEN}已写入全局配置 ${cfg_file}${NC} (backend: ${SELECTED_BACKEND})"

    # 4. 生成环境变量提示
    if [[ "${ISSUE_CONFIGURED:-false}" == true ]]; then
        echo ""
        echo -e "  ${YELLOW}Issue 驱动模式需要设置环境变量，请添加到 shell 配置:${NC}"
        echo ""
        echo -e "    export WORKFLOW_PROJECT_OWNER=\"${ISSUE_PROJECT_OWNER}\""
        echo -e "    export WORKFLOW_PROJECT_NUMBER=\"${ISSUE_PROJECT_NUMBER}\""
        echo -e "    export WORKFLOW_ISSUE_LABEL=\"${ISSUE_LABEL}\""
    fi
}

# ─── Step 5: 验证 ────────────────────────────────────────────

run_verify() {
    print_step 5 5 "验证安装"

    # verify 失败不阻塞 setup 完成提示（verify return 1 是给 CI/脚本用的）
    # 首次安装时用户可能还没登录对应的后端 CLI，这很正常
    set +e
    HTTP_PROXY= HTTPS_PROXY= bash "${PROJECT_DIR}/bin/sparring" verify 2>&1
    local rc=$?
    set -e
    if [[ $rc -ne 0 ]]; then
        echo ""
        echo -e "${YELLOW}⚠ verify 报告有问题，但 setup 已经完成。${NC}"
        echo -e "${DIM}  按上面提示登录对应 CLI 后重跑 sparring verify 即可。${NC}"
    fi
}

# ─── 主流程 ──────────────────────────────────────────────────

main() {
    print_header
    check_dependencies
    select_backend
    configure_issue_mode
    install_and_configure
    run_verify

    echo ""
    echo -e "${BOLD}${GREEN}═══════════════════════════════════════════${NC}"
    echo -e "${BOLD}${GREEN}  Setup 完成！${NC}"
    echo -e "${BOLD}${GREEN}═══════════════════════════════════════════${NC}"
    echo ""
    echo -e "  开始使用："
    echo -e "    ${BOLD}/sparring:workflow${NC} <任务描述>    — 普通模式"
    echo -e "    ${BOLD}/sparring:yolo${NC} <任务描述>        — 全自动模式"
    echo -e "    ${BOLD}/sparring:issue${NC} <看板URL>        — Issue 驱动模式"
    echo ""
    echo -e "  更多帮助: ${DIM}sparring help${NC}"
    echo ""
}

main "$@"
